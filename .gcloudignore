# This file specifies files that are *not* uploaded to Google Cloud
# using gcloud. It follows the same syntax as .gitignore.

# Exclude EVERYTHING except what we explicitly need
*

# Include only what's needed for backend Docker build
!backend/
!backend/**
!packages/
!packages/bayit-voice-pipeline/
!packages/bayit-voice-pipeline/**
!packages/bayit-translation/
!packages/bayit-translation/**
!packages/olorin-core/
!packages/olorin-core/**
!packages/olorin-shared/
!packages/olorin-shared/**
!packages/olorin-email/
!packages/olorin-email/**
!packages/python/
!packages/python/olorin-i18n/
!packages/python/olorin-i18n/**
!packages/ui/
!packages/ui/shared-i18n/
!packages/ui/shared-i18n/**
!shared/
!shared/i18n/
!shared/i18n/locales/
!shared/i18n/locales/**
!cloudbuild.yaml
!Dockerfile

# But exclude node_modules, cache, logs from included directories
backend/node_modules/
backend/__pycache__/
backend/**/__pycache__/
backend/venv/
backend/.venv/
backend/uploads/
backend/logs/
backend/*.log
backend/.env
backend/.pytest_cache/
packages/**/node_modules/
packages/**/__pycache__/
packages/**/.pytest_cache/
