// Debug.xcconfig - Development build settings
// Optionally include Local.xcconfig for developer-specific overrides (e.g. DEV_HOST)
#include? "Local.xcconfig"

DEV_HOST = localhost
API_BASE_URL = http:/$()/$(DEV_HOST):8000/api/v1
WEBSOCKET_BASE_URL = ws:/$()/$(DEV_HOST):8000/api/v1
API_RETRYABLE_STATUS_CODES = 408,429,500,502,503,504
PROGRESS_TRACKING_INTERVAL_SECONDS = 15
HOME_CONTENT_ROW_LIMIT = 8
DEFAULT_CULTURE_ID = israeli
HIDDEN_CHANNEL_KEYWORDS = king 5,king5,cnn,abc
SUPPORT_EMAIL = support@olorin.ai
OWNER_MODE = YES
IP_GEOLOCATION_URL = https:/$()/ipapi.co/json/
YOUTUBE_CLIENT_ID = 624470113582-m0mk0hkv8pi1r7j740nm1vgtddjh8dvh.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET = $(YOUTUBE_CLIENT_SECRET)
