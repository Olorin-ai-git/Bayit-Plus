backend/**/*.pyc
backend/venv/
backend/.venv/
backend/.pytest_cache/
backend/logs/
backend/*.log
backend/.env
backend/.env.*
!backend/.env.example
backend/credentials.json
backend/service-account.json
backend/*.pem
backend/*.key
backend/*.zip
backend/*.tar.gz
backend/scripts/
backend/docs/
backend/backups/

# Packages - keep only backend Python dependencies
packages/firebase-config/
packages/ui/design-tokens/
packages/ui/design-tokens.local/
packages/ui/glass-components/
packages/ui/shared-hooks/
packages/ui/shared-icons/
packages/ui/shared-services/
packages/ui/shared-stores/
packages/ui/node_modules/
scripts/backend/.hls_conversion_state/

# Exclude scripts directory (not needed in Docker build)
scripts/
