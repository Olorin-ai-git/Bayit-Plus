# Exclude large frontend/mobile apps (not needed for backend Docker build)
web/
mobile-app/
tv-app/
tvos-app/
tizen/
webos/
ios/
cli/
partner-portal/
playwright-report/
chrome-extension/
public/
docs-portal/

# Root node_modules
node_modules/

# Shared (exclude large directories, keep i18n for backend)
shared/node_modules/
shared/assets/
shared/models/
shared/components/
shared/hooks/
shared/services/
shared/stores/
shared/styles/
shared/utils/

# Test results
test-results/

# Documentation
docs/

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# CI/CD
.github/

# Backend-specific
backend/uploads/
backend/__pycache__/
backend/**/__pycache__/
