{
  "name": "@olorin/glass-ui",
  "version": "2.0.0",
  "description": "Olorin.ai Glass UI Component Library - Glassmorphic components for React Native and Web",
  "license": "UNLICENSED",
  "private": true,
  "sideEffects": false,
  "main": "./dist/native/index.js",
  "module": "./dist/native/index.mjs",
  "types": "./dist/native/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/native/index.d.mts",
        "default": "./dist/native/index.mjs"
      },
      "require": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native/index.d.mts",
        "default": "./dist/native/index.mjs"
      },
      "require": {
        "types": "./dist/native/index.d.ts",
        "default": "./dist/native/index.js"
      }
    },
    "./web": {
      "import": {
        "types": "./dist/web/index.d.mts",
        "default": "./dist/web/index.mjs"
      },
      "require": {
        "types": "./dist/web/index.d.ts",
        "default": "./dist/web/index.js"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks/index.d.mts",
        "default": "./dist/hooks/index.mjs"
      },
      "require": {
        "types": "./dist/hooks/index.d.ts",
        "default": "./dist/hooks/index.js"
      }
    },
    "./theme": {
      "import": {
        "types": "./dist/theme/index.d.mts",
        "default": "./dist/theme/index.mjs"
      },
      "require": {
        "types": "./dist/theme/index.d.ts",
        "default": "./dist/theme/index.js"
      }
    },
    "./stores": {
      "import": {
        "types": "./dist/stores/index.d.mts",
        "default": "./dist/stores/index.mjs"
      },
      "require": {
        "types": "./dist/stores/index.d.ts",
        "default": "./dist/stores/index.js"
      }
    },
    "./contexts": {
      "import": {
        "types": "./dist/contexts/index.d.mts",
        "default": "./dist/contexts/index.mjs"
      },
      "require": {
        "types": "./dist/contexts/index.d.ts",
        "default": "./dist/contexts/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && node scripts/verify-exports.cjs",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@olorin/design-tokens": "2.0.0",
    "@olorin/shared-icons": "2.0.0",
    "nanoid": "^5.0.0",
    "zustand": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-svg": "^15.0.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    },
    "react-native-linear-gradient": {
      "optional": true
    },
    "react-native-reanimated": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-gesture-handler": {
      "optional": true
    },
    "react-native-svg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@testing-library/react-native": "^12.4.0",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^3.19.5",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-svg": "^15.0.0",
    "@types/react": "^18.3.31",
    "@types/react-native": "^0.73.0",
    "jest": "^29.7.0",
    "nativewind": "^4.2.1",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "tailwindcss": "^3.4.19",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.0",
    "typescript": "^5.7.0"
  },
  "keywords": [
    "react-native",
    "glass",
    "glassmorphism",
    "ui-components",
    "design-system",
    "olorin",
    "bayit-plus",
    "tv",
    "tvos",
    "android-tv"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olorin-ai/olorin-ecosystem.git",
    "directory": "packages/ui/glass-components"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  }
}
