<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext globally for BYOC local servers (Plex, IPTV, Xtream on LAN) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Pin certificates for Bayit API traffic -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">bayit.tv</domain>
        <pin-set expiration="2027-03-08">
            <pin digest="SHA-256">I2GCnid5uIcpXIkOFz2o1TKUXqhYsswsgRbc3ve8q5U=</pin>
            <pin digest="SHA-256">OdSlmQD9NWJh4EbcOHBxkhygPwNSwA9Q91eounfbcoE=</pin>
        </pin-set>
    </domain-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
