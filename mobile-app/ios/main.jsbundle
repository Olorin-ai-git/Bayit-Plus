93e\u0907\u0935 AI \u0921\u0947\u091f\u093e \u092b\u094d\u0932\u094b",services:{elevenlabs:"ElevenLabs",googleCloud:"Google Cloud",googleTranslate:"Google Translate",openai:"OpenAI",claude:"Claude",spacy:"spaCy",redis:"Redis",tavily:"Tavily"},translation:{nodes:{auth:{title:"WebSocket Auth + Rate Limit",input:"WebSocket connection request with JWT token",output:"Authenticated session with rate limit applied"},quota:{title:"Quota Check (30s cache)",input:"User ID and feature type",output:"Quota validation result (cached 30s)"},stt:{title:"STT (ElevenLabs Scribe v2)",input:"Raw audio stream from channel",output:"Transcribed text segments with timestamps"},dedup:{title:"Deduplication (70% overlap)",input:"New transcript segment",output:"Filtered unique segments (70% overlap threshold)"},predictive:{title:"Predictive Subtitle Emit (optional)",input:"Original language transcript",output:"Early subtitle display before translation"},translate:{title:"Translation (Google/OpenAI/Claude)",input:"Original language text segment",output:"Translated text in target language"},chunk:{title:"Text Chunking (max 80 chars)",input:"Translated text of any length",output:"Chunks of max 80 characters for display"},emit:{title:"Final Subtitle Emit",input:"Chunked translated subtitle",output:"WebSocket event to client with subtitle data"}}},dubbing:{nodes:{auth:{title:"WebSocket Auth + Rate Limit",input:"WebSocket connection request with JWT token",output:"Authenticated session with rate limit applied"},quota:{title:"Quota Check",input:"User ID and dubbing feature type",output:"Quota validation result"},session:{title:"Session Init + ChannelSTTManager Subscribe",input:"Channel ID and language preferences",output:"Subscribed to shared STT channel manager"},stt:{title:"Shared STT (1 per channel, 99% cost save)",input:"Channel audio stream (shared across users)",output:"Shared transcript for all channel subscribers"},transcriptEmit:{title:"Transcript Emit to Client",input:"Shared STT transcript segment",output:"WebSocket event with original transcript"},translate:{title:"Translation",input:"Original transcript text",output:"Translated text in user's target language"},translationEmit:{title:"Translation Emit to Client",input:"Translated text segment",output:"WebSocket event with translated text"},tts:{title:"TTS Streaming (new conn per transcript)",input:"Translated text for speech synthesis",output:"Streaming audio chunks from ElevenLabs"},encode:{title:"Audio Encoding (base64)",input:"Raw audio buffer from TTS",output:"Base64-encoded audio ready for transport"},audioEmit:{title:"Dubbed Audio Emit",input:"Encoded audio chunk",output:"WebSocket event with dubbed audio data"}}},trivia:{nodes:{auth:{title:"WebSocket Auth + Rate Limit",input:"WebSocket connection request with JWT token",output:"Authenticated session with rate limit applied"},quota:{title:"Quota Check (fact-based)",input:"User ID and trivia feature type",output:"Quota validation (per-fact billing)"},topic:{title:"Topic Detection (NER)",input:"Transcript text from live channel",output:"Detected named entities and topics"},mention:{title:"Mention Tracking (min 2, 60-min cooldown)",input:"Detected entity with mention count",output:"Eligible topic (2+ mentions, not in cooldown)"},session:{title:"Session Management (FIFO max 100)",input:"New trivia session request",output:"Session slot allocated (FIFO eviction at 100)"},cache:{title:"Fact Cache Lookup (24h TTL)",input:"Topic entity for fact lookup",output:"Cached fact if available (24h TTL)"},search:{title:"Web Search (cache miss only)",input:"Topic entity needing fresh facts",output:"Web search results from Tavily"},extract:{title:"Fact Extraction (cache miss only)",input:"Web search results for topic",output:"Structured trivia fact extracted by AI"},tracking:{title:"Session Tracking + Interval (15s min)",input:"Generated trivia fact",output:"Fact queued with 15s minimum interval"},emit:{title:"Trivia Fact Emit (multilingual)",input:"Trivia fact with translations",output:"WebSocket event with multilingual trivia"}}}},pending:{description:"\u0906\u092a\u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0939\u094b \u0930\u0939\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902...",helpText:"\u092f\u0939 \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 \u0915\u0941\u091b \u0938\u0947\u0915\u0902\u0921 \u0932\u0947\u0924\u093e \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092f\u0939 \u092a\u0943\u0937\u094d\u0920 \u092c\u0902\u0926 \u0928 \u0915\u0930\u0947\u0902\u0964",takingLonger:"\u092f\u0939 \u0905\u092a\u0947\u0915\u094d\u0937\u093e \u0938\u0947 \u0905\u0927\u093f\u0915 \u0938\u092e\u092f \u0932\u0947 \u0930\u0939\u093e \u0939\u0948...",timeElapsed:"\u092c\u0940\u0924\u093e \u0938\u092e\u092f: {{time}}",title:"\u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u0938\u0902\u0938\u094d\u0915\u0930\u0923"},privacy:{children:{content:"\u0939\u092e\u093e\u0930\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u092d\u0940 \u0909\u092e\u094d\u0930 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 Olorin.ai LLC \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 13 \u0935\u0930\u094d\u0937 \u0938\u0947 \u0915\u092e \u0909\u092e\u094d\u0930 \u0915\u0947 \u092c\u091a\u094d\u091a\u094b\u0902 \u0938\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u092a\u0939\u091a\u093e\u0928 \u092f\u094b\u0917\u094d\u092f \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u094d\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092f\u0926\u093f \u0906\u092a \u090f\u0915 \u0905\u092d\u093f\u092d\u093e\u0935\u0915 \u0939\u0948\u0902 \u0914\u0930 \u092e\u093e\u0928\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0915\u0947 \u092c\u091a\u094d\u091a\u0947 \u0928\u0947 \u0939\u092e\u0947\u0902 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0940 \u0939\u0948, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964",title:"5. \u092c\u091a\u094d\u091a\u0947"},collection:{audio:{data:"\u090f\u0915\u0924\u094d\u0930\u093f\u0924 \u0921\u0947\u091f\u093e: \u091f\u0940\u0935\u0940 \u092a\u094d\u0930\u0938\u093e\u0930\u0923 \u0915\u0947 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0911\u0921\u093f\u092f\u094b \u0928\u092e\u0942\u0928\u0947\u0964",intro:"\u092f\u0926\u093f \u0906\u092a \u0911\u0921\u093f\u092f\u094b \u0938\u093f\u0902\u0915\u094d\u0930\u094b\u0928\u093e\u0907\u091c\u093c\u0947\u0936\u0928 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0935\u093e\u0932\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0910\u092a \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u090f\u0915\u094d\u0938\u0947\u0938 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964",purpose:"\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f: \u0938\u093f\u0902\u0915\u094d\u0930\u094b\u0928\u093e\u0907\u091c\u093c\u0947\u0936\u0928 \u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u092a\u094d\u0930\u0938\u093e\u0930\u0923 \u0915\u0947 \u0911\u0921\u093f\u092f\u094b \u092b\u093c\u093f\u0902\u0917\u0930\u092a\u094d\u0930\u093f\u0902\u091f \u0938\u0947 \u092e\u093f\u0932\u093e\u0928 \u0915\u0930\u0928\u093e\u0964",retention:"\u0938\u0902\u0930\u0915\u094d\u0937\u0923: \u0935\u093f\u091c\u093c\u0941\u0905\u0932 \u0921\u0947\u091f\u093e \u0915\u0940 \u0924\u0930\u0939, \u0911\u0921\u093f\u092f\u094b \u0928\u092e\u0942\u0928\u0947 \u0930\u0940\u092f\u0932-\u091f\u093e\u0907\u092e \u092e\u0947\u0902 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0924\u0941\u0930\u0902\u0924 \u0939\u091f\u093e \u0926\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0935\u093e\u0930\u094d\u0924\u093e\u0932\u093e\u092a \u0938\u0941\u0928\u0924\u0947 \u092f\u093e \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964",title:"\u0936\u0940\u0930\u094d\u0937\u0915"},camera:{data:"\u0921\u0947\u091f\u093e",intro:"\u0939\u092e\u093e\u0930\u0940 \u092e\u0941\u0916\u094d\u092f \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u2014\u0905\u092a\u0928\u0947 \u091f\u0940\u0935\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0905\u0928\u0941\u0935\u093e\u0926\u093f\u0924 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0938\u093f\u0902\u0915\u094d\u0930\u094b\u0928\u093e\u0907\u091c\u093c \u0915\u0930\u0928\u093e\u2014Bayit+ \u0915\u094b \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948",purpose:"\u0909\u0926\u094d\u0926\u0947\u0936\u094d\u092f",retention:"\u0938\u0902\u0930\u0915\u094d\u0937\u0923: \u092f\u0939 \u0921\u0947\u091f\u093e \u0915\u094d\u0937\u0923\u092d\u0902\u0917\u0941\u0930 \u0939\u0948\u0964 \u092b\u093c\u094d\u0930\u0947\u092e \u0924\u0941\u0930\u0902\u0924 \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u0947\u0902 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0938\u093f\u0902\u0915\u094d\u0930\u094b\u0928\u093e\u0907\u091c\u093c\u0947\u0936\u0928 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0939\u091f\u093e \u0926\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e \u0906\u092a\u0915\u0947 \u0918\u0930 \u092f\u093e \u092a\u0930\u093f\u0935\u093e\u0930 \u0915\u0940 \u091b\u0935\u093f\u092f\u094b\u0902 \u0915\u094b \u0926\u0947\u0916\u0924\u0947, \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u092f\u093e \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964",title:"\u090f. \u0915\u0948\u092e\u0930\u093e \u0914\u0930 \u0935\u093f\u091c\u093c\u0941\u0905\u0932 \u0938\u093f\u0902\u0915\u094d\u0930\u094b\u0928\u093e\u0907\u091c\u093c\u0947\u0936\u0928 \u0921\u0947\u091f\u093e"},title:"2. \u0939\u092e \u0915\u094c\u0928 \u0938\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0915\u0948\u0938\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902",usage:{aggregate:"\u0938\u092e\u0941\u091a\u094d\u091a\u092f",content:"\u0939\u092e \u0910\u092a \u0938\u094d\u0925\u093f\u0930\u0924\u093e \u092e\u0947\u0902 \u0938\u0941\u0927\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0917\u0948\u0930-\u092a\u0939\u091a\u093e\u0928 \u092f\u094b\u0917\u094d\u092f \u0924\u0915\u0928\u0940\u0915\u0940 \u0921\u0947\u091f\u093e \u090f\u0915\u0924\u094d\u0930 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u091c\u093f\u0938\u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902:",crash:"\u0915\u094d\u0930\u0948\u0936 \u0932\u0949\u0917 \u0914\u0930 \u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938\u0964",device:"\u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u094d\u0930\u0915\u093e\u0930 \u0914\u0930 \u0911\u092a\u0930\u0947\u091f\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0902\u0938\u094d\u0915\u0930\u0923\u0964",title:"\u0938\u0940. \u0909\u092a\u092f\u094b\u0917 \u0914\u0930 \u0924\u0915\u0928\u0940\u0915\u0940 \u0921\u0947\u091f\u093e"}},contact:{intro:"\u092f\u0926\u093f \u0907\u0938 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0906\u092a\u0915\u0947 \u0915\u094b\u0908 \u092a\u094d\u0930\u0936\u094d\u0928 \u0939\u0948\u0902, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902:",title:"7. \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902"},intro:{commitment:"\u0939\u092e\u0928\u0947 Bayit+ \u0915\u094b \"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e-\u092a\u094d\u0930\u0925\u092e\" \u0906\u0930\u094d\u0915\u093f\u091f\u0947\u0915\u094d\u091a\u0930 \u0915\u0947 \u0938\u093e\u0925 \u092c\u0928\u093e\u092f\u093e \u0939\u0948\u0964 \u0939\u092e \u0906\u092a\u0915\u0947 \u0932\u093f\u0935\u093f\u0902\u0917 \u0930\u0942\u092e \u0915\u094b \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947\u0964 \u0939\u092e\u093e\u0930\u0940 \u0924\u0915\u0928\u0940\u0915 \u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0940 \u0939\u0948",content:"\u0938\u093e\u092e\u0917\u094d\u0930\u0940",title:"1. \u092a\u0930\u093f\u091a\u092f"},lastUpdated:"\u0905\u0902\u0924\u093f\u092e \u0905\u092a\u0921\u0947\u091f: 27 \u091c\u0928\u0935\u0930\u0940, 2026",retention:{account:"\u0916\u093e\u0924\u093e \u0921\u0947\u091f\u093e: \u0906\u092a\u0915\u0940 \u0938\u0926\u0938\u094d\u092f\u0924\u093e \u0914\u0930 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u0913\u0902 \u0915\u094b \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0947\u0935\u0932 \u0906\u092a\u0915\u093e \u0916\u093e\u0924\u093e \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0928\u0947 \u0924\u0915 \u0938\u0902\u0930\u0915\u094d\u0937\u093f\u0924\u0964",sync:"\u0938\u093f\u0902\u0915",title:"4. \u0921\u0947\u091f\u093e \u0938\u0902\u0930\u0915\u094d\u0937\u0923"},rights:{content:"\u0906\u092a\u0915\u0947 \u0938\u094d\u0925\u093e\u0928 \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930, \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0905\u092a\u0928\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a, \u0938\u0941\u0927\u093e\u0930 \u092f\u093e \u0935\u093f\u0932\u094b\u092a\u0928 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964 \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u0910\u092a \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0905\u092a\u0928\u093e Bayit+ \u0916\u093e\u0924\u093e \u0939\u091f\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964",title:"6. \u0906\u092a\u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930"},sharing:{ai:"\u090f\u0906\u0908 \u092a\u094d\u0930\u094b\u0938\u0947\u0938\u093f\u0902\u0917: \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u092a\u094d\u0930\u0938\u093e\u0930\u0923 \u092b\u093c\u0940\u0921 \u0938\u0947 \u0930\u0940\u092f\u0932-\u091f\u093e\u0907\u092e \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0914\u0930 \u0911\u0921\u093f\u092f\u094b \u0905\u0928\u0941\u0935\u093e\u0926 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u0947\u0935\u093e\u090f\u0901\u0964",cloud:"\u0915\u094d\u0932\u093e\u0909\u0921",noSale:"Olorin.ai LLC \u0906\u092a\u0915\u093e \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u092c\u0947\u091a\u0924\u093e\u0964 \u0939\u092e \u0905\u092a\u0928\u0947 \u092c\u0941\u0928\u093f\u092f\u093e\u0926\u0940 \u0922\u093e\u0902\u091a\u0947 \u0915\u094b \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0924\u0943\u0924\u0940\u092f-\u092a\u0915\u094d\u0937 \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u0947\u0926\u093e\u0930\u0940 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0907\u0928 \u092a\u094d\u0930\u0926\u093e\u0924\u093e\u0913\u0902 \u0915\u094b \u0906\u092a\u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0947\u0935\u0932 \u0939\u092e\u0947\u0902 \u092f\u0947 \u0938\u0947\u0935\u093e\u090f\u0901 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948:",title:"3. \u0921\u0947\u091f\u093e \u0936\u0947\u092f\u0930\u093f\u0902\u0917 \u0914\u0930 \u0924\u0943\u0924\u0940\u092f \u092a\u0915\u094d\u0937"}},semantic:{info:"\u090f\u0906\u0908-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0938\u0930\u094d\u091a \u0905\u0930\u094d\u0925 \u0938\u092e\u091d\u0924\u0940 \u0939\u0948, \u0928 \u0915\u0947\u0935\u0932 \u0915\u0940\u0935\u0930\u094d\u0921",infoTitle:"\u0938\u0947\u092e\u093e\u0902\u091f\u093f\u0915 \u0938\u0930\u094d\u091a",keyword:"\u0915\u0940\u0935\u0930\u094d\u0921",semantic:"\u0938\u0947\u092e\u093e\u0902\u091f\u093f\u0915"},success:{continue:"\u091c\u093e\u0930\u0940 \u0930\u0916\u0947\u0902",description:"\u0906\u092a\u0915\u093e \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u092b\u0932\u0924\u093e\u092a\u