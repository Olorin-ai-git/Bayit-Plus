092f\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964",scheduleTitle:"\u0915\u0949\u0932 \u0936\u0947\u0921\u094d\u092f\u0942\u0932 \u0915\u0930\u0928\u093e \u092a\u0938\u0902\u0926 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902?",scheduleSubtitle:"\u0939\u092e\u093e\u0930\u0940 \u091f\u0940\u092e \u0915\u0947 \u0938\u093e\u0925 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u092e\u094b \u092c\u0941\u0915 \u0915\u0930\u0947\u0902",scheduleCta:"\u0921\u0947\u092e\u094b \u0915\u0949\u0932 \u0936\u0947\u0921\u094d\u092f\u0942\u0932 \u0915\u0930\u0947\u0902"},pricingPage:{title:"\u0915\u093f\u092b\u093e\u092f\u0924\u0940",titleHighlight:"\u092e\u0942\u0932\u094d\u092f \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u092f\u094b\u091c\u0928\u093e\u090f\u0902",subtitle:"\u0905\u092a\u0928\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0913\u0902 \u0915\u0947 \u0905\u0928\u0941\u0930\u0942\u092a \u092f\u094b\u091c\u0928\u093e \u091a\u0941\u0928\u0947\u0902",comparisonTitle:"\u0935\u093f\u0936\u0947\u0937\u0924\u093e\u0913\u0902 \u0915\u0940 \u0924\u0941\u0932\u0928\u093e",faqTitle:"\u0905\u0915\u094d\u0938\u0930 \u092a\u0942\u091b\u0947 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u092a\u094d\u0930\u0936\u094d\u0928",faq:{q1:"\u092e\u0942\u0932\u094d\u092f \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u0915\u0940 \u0917\u0923\u0928\u093e \u0915\u0948\u0938\u0947 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948?",a1:"\u092e\u0942\u0932\u094d\u092f \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923 \u0906\u092a\u0915\u0940 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0913\u0902 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917 \u092a\u0930 \u0906\u0927\u093e\u0930\u093f\u0924 \u0939\u0948\u0964 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0909\u0926\u094d\u0927\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964",q2:"\u0915\u094d\u092f\u093e \u092e\u0948\u0902 \u092c\u093e\u0926 \u092e\u0947\u0902 \u0905\u092a\u0928\u0940 \u092f\u094b\u091c\u0928\u093e \u0915\u094b \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0942\u0902?",a2:"\u0939\u093e\u0902, \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u0905\u092a\u0917\u094d\u0930\u0947\u0921 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e \u0906\u092a\u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u094b \u0938\u0939\u091c\u0924\u093e \u0938\u0947 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0947\u0902\u0917\u0947\u0964",q3:"\u0915\u094c\u0928 \u0938\u093e \u0938\u092a\u094b\u0930\u094d\u091f \u0936\u093e\u092e\u093f\u0932 \u0939\u0948?",a3:"\u0938\u092d\u0940 \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u092e\u0947\u0902 \u0908\u092e\u0947\u0932 \u0938\u092a\u094b\u0930\u094d\u091f \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0964 \u092a\u094d\u0930\u094b\u092b\u0947\u0936\u0928\u0932 \u0914\u0930 \u090f\u0902\u091f\u0930\u092a\u094d\u0930\u093e\u0907\u091c \u092f\u094b\u091c\u0928\u093e\u0913\u0902 \u092e\u0947\u0902 \u0938\u092e\u0930\u094d\u092a\u093f\u0924 \u0916\u093e\u0924\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0915\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0938\u092a\u094b\u0930\u094d\u091f \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0964"},professional:{name:"\u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915",price:"\u0909\u0926\u094d\u0927\u0930\u0923 \u0915\u0947 \u0932\u093f\u090f \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902",priceNote:"\u0915\u0938\u094d\u091f\u092e \u092e\u0942\u0932\u094d\u092f \u0928\u093f\u0930\u094d\u0927\u093e\u0930\u0923",description:"\u0909\u0928\u094d\u0928\u0924 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0913\u0902 \u0935\u093e\u0932\u0947 \u092c\u0922\u093c\u0924\u0947 \u0935\u094d\u092f\u0935\u0938\u093e\u092f\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f",cta:"\u0909\u0926\u094d\u0927\u0930\u0923 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902"},enterprise:{name:"\u0909\u0926\u094d\u092f\u092e",price:"\u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924",priceNote:"\u0935\u0949\u0932\u094d\u092f\u0942\u092e \u0906\u0927\u093e\u0930\u093f\u0924",description:"\u092c\u0921\u093c\u0947 \u0938\u0902\u0917\u0920\u0928\u094b\u0902 \u0914\u0930 \u0909\u0926\u094d\u092f\u092e \u0924\u0948\u0928\u093e\u0924\u0940 \u0915\u0947 \u0932\u093f\u090f",cta:"\u092c\u093f\u0915\u094d\u0930\u0940 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902"},ctaTitle:"\u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0902?",ctaSubtitle:"\u0906\u0907\u090f \u0905\u092a\u0928\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0913\u0902 \u092a\u0930 \u091a\u0930\u094d\u091a\u093e \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0939\u0940 \u092f\u094b\u091c\u0928\u093e \u0916\u094b\u091c\u0947\u0902",ctaButton:"\u092c\u093f\u0915\u094d\u0930\u0940 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902"},featuresPage:{title:"\u0936\u0915\u094d\u0924\u093f\u0936\u093e\u0932\u0940",titleHighlight:"\u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902",subtitle:"\u0938\u092b\u0932 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u094b \u091c\u094b \u0915\u0941\u091b \u092d\u0940 \u091a\u093e\u0939\u093f\u090f",techSpecsTitle:"\u0924\u0915\u0928\u0940\u0915\u0940 \u0935\u093f\u0928\u093f\u0930\u094d\u0926\u0947\u0936",workflowTitle:"\u092f\u0939 \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948",workflow:{s1:{title:"\u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902",description:"\u0905\u092a\u0928\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0905\u092a\u0932\u094b\u0921 \u0914\u0930 \u0935\u094d\u092f\u0935\u0938\u094d\u0925\u093f\u0924 \u0915\u0930\u0947\u0902"},s2:{title:"\u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0947\u0902",description:"\u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u090f\u0902 \u0914\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0938\u0947\u091f \u0915\u0930\u0947\u0902"},s3:{title:"\u0924\u0948\u0928\u093e\u0924 \u0915\u0930\u0947\u0902",description:"\u0905\u092a\u0928\u0947 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0932\u093e\u0907\u0935 \u091c\u093e\u090f\u0902"},s4:{title:"\u092e\u0949\u0928\u093f\u091f\u0930 \u0915\u0930\u0947\u0902",description:"\u092a\u094d\u0930\u0926\u0930\u094d\u0936\u0928 \u091f\u094d\u0930\u0948\u0915 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0915\u0930\u0947\u0902"}},ctaTitle:"\u0935\u093f\u0936\u0947\u0937\u0924\u093e\u0913\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0902?",ctaSubtitle:"\u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u092e\u094b \u0915\u0947 \u0938\u093e\u0925 \u0938\u092d\u0940 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u0913\u0902 \u0915\u094b \u0915\u094d\u0930\u093f\u092f\u093e \u092e\u0947\u0902 \u0926\u0947\u0916\u0947\u0902",ctaButton:"\u0921\u0947\u092e\u094b \u0936\u0947\u0921\u094d\u092f\u0942\u0932 \u0915\u0930\u0947\u0902"},demoPage:{title:"\u0939\u092e\u093e\u0930\u093e \u0926\u0947\u0916\u0947\u0902",titleHighlight:"\u092a\u094d\u0932\u0947\u091f\u092b\u093c\u0949\u0930\u094d\u092e",subtitle:"\u0939\u092e\u093e\u0930\u0947 \u0938\u092e\u093e\u0927\u093e\u0928 \u0915\u0940 \u0936\u0915\u094d\u0924\u093f \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0915\