9cd\u09a4\u09be \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u09aa\u09be\u09a0\u09be\u09a8\u09cb \u09b9\u09af\u09bc\u09c7\u099b\u09c7! \u0986\u09ae\u09b0\u09be \u09b6\u09c0\u0998\u09cd\u09b0\u0987 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09ac\u0964",error:"\u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09aa\u09be\u09a0\u09be\u09a4\u09c7 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09aa\u09c1\u09a8\u09b0\u09be\u09af\u09bc \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964",scheduleTitle:"\u0995\u09b2 \u09b6\u09bf\u09a1\u09bf\u0989\u09b2 \u0995\u09b0\u09a4\u09c7 \u09aa\u099b\u09a8\u09cd\u09a6 \u0995\u09b0\u09c7\u09a8?",scheduleSubtitle:"\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09a6\u09b2\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u098f\u0995\u099f\u09bf \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a1\u09c7\u09ae\u09cb \u09ac\u09c1\u0995 \u0995\u09b0\u09c1\u09a8",scheduleCta:"\u09a1\u09c7\u09ae\u09cb \u0995\u09b2 \u09b6\u09bf\u09a1\u09bf\u0989\u09b2 \u0995\u09b0\u09c1\u09a8"},pricingPage:{title:"\u09b8\u09be\u09b6\u09cd\u09b0\u09af\u09bc\u09c0",titleHighlight:"\u09ae\u09c2\u09b2\u09cd\u09af \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be",subtitle:"\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u0985\u09a8\u09c1\u09b8\u09be\u09b0\u09c7 \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be \u099a\u09af\u09bc\u09a8 \u0995\u09b0\u09c1\u09a8",comparisonTitle:"\u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u09a4\u09c1\u09b2\u09a8\u09be",faqTitle:"\u09aa\u09cd\u09b0\u09be\u09af\u09bc\u09b6\u0987 \u099c\u09bf\u099c\u09cd\u099e\u09be\u09b8\u09bf\u09a4 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8",faq:{q1:"\u09ae\u09c2\u09b2\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0997\u09a3\u09a8\u09be \u0995\u09b0\u09be \u09b9\u09af\u09bc?",a1:"\u09ae\u09c2\u09b2\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09bf\u09b0\u09cd\u09a6\u09bf\u09b7\u09cd\u099f \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u098f\u09ac\u0982 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u0989\u09aa\u09b0 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf \u0995\u09b0\u09c7\u0964 \u0995\u09be\u09b8\u09cd\u099f\u09ae \u0989\u09a6\u09cd\u09a7\u09c3\u09a4\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964",q2:"\u0986\u09ae\u09bf \u0995\u09bf \u09aa\u09b0\u09c7 \u0986\u09ae\u09be\u09b0 \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be \u0986\u09aa\u0997\u09cd\u09b0\u09c7\u09a1 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf?",a2:"\u09b9\u09cd\u09af\u09be\u0981, \u0986\u09aa\u09a8\u09bf \u09af\u09c7\u0995\u09cb\u09a8\u09cb \u09b8\u09ae\u09af\u09bc \u0986\u09aa\u0997\u09cd\u09b0\u09c7\u09a1 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964 \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u09a8\u09bf\u09b0\u09cd\u09ac\u09bf\u0998\u09cd\u09a8\u09c7 \u09b8\u09cd\u09a5\u09be\u09a8\u09be\u09a8\u09cd\u09a4\u09b0\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u09b8\u09be\u09b9\u09be\u09af\u09cd\u09af \u0995\u09b0\u09ac\u0964",q3:"\u0995\u09cb\u09a8 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4?",a3:"\u09b8\u09ae\u09b8\u09cd\u09a4 \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be\u09af\u09bc \u0987\u09ae\u09c7\u09b2 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4\u0964 \u09aa\u09c7\u09b6\u09be\u09a6\u09be\u09b0 \u098f\u09ac\u0982 \u098f\u09a8\u09cd\u099f\u09be\u09b0\u09aa\u09cd\u09b0\u09be\u0987\u099c \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be\u09af\u09bc \u09a8\u09bf\u09ac\u09c7\u09a6\u09bf\u09a4 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09ae\u09cd\u09af\u09be\u09a8\u09c7\u099c\u09be\u09b0\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0985\u0997\u09cd\u09b0\u09be\u09a7\u09bf\u0995\u09be\u09b0 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4\u0964"},professional:{name:"\u09aa\u09c7\u09b6\u09be\u09a6\u09be\u09b0",price:"\u0989\u09a6\u09cd\u09a7\u09c3\u09a4\u09bf\u09b0 \u099c\u09a8\u09cd\u09af \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8",priceNote:"\u0995\u09be\u09b8\u09cd\u099f\u09ae \u09ae\u09c2\u09b2\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09a3",description:"\u0989\u09a8\u09cd\u09a8\u09a4 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09b8\u09b9 \u0995\u09cd\u09b0\u09ae\u09ac\u09b0\u09cd\u09a7\u09ae\u09be\u09a8 \u09ac\u09cd\u09af\u09ac\u09b8\u09be\u09b0 \u099c\u09a8\u09cd\u09af",cta:"\u0989\u09a6\u09cd\u09a7\u09c3\u09a4\u09bf \u09aa\u09be\u09a8"},enterprise:{name:"\u098f\u09a8\u09cd\u099f\u09be\u09b0\u09aa\u09cd\u09b0\u09be\u0987\u099c",price:"\u0995\u09be\u09b8\u09cd\u099f\u09ae",priceNote:"\u09ad\u09b2\u09bf\u0989\u09ae \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995",description:"\u09ac\u09a1\u09bc \u09b8\u0982\u09b8\u09cd\u09a5\u09be \u098f\u09ac\u0982 \u098f\u09a8\u09cd\u099f\u09be\u09b0\u09aa\u09cd\u09b0\u09be\u0987\u099c \u09b8\u09cd\u09a5\u09be\u09aa\u09a8\u09be\u09b0 \u099c\u09a8\u09cd\u09af",cta:"\u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8"},ctaTitle:"\u09b6\u09c1\u09b0\u09c1 \u0995\u09b0\u09a4\u09c7 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09c1\u09a4?",ctaSubtitle:"\u0986\u09b8\u09c1\u09a8 \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09bf\u09af\u09bc\u09c7 \u0986\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09bf \u098f\u09ac\u0982 \u09a8\u09bf\u0996\u09c1\u0981\u09a4 \u09aa\u09b0\u09bf\u0995\u09b2\u09cd\u09aa\u09a8\u09be \u0996\u09c1\u0981\u099c\u09c7 \u09aa\u09be\u0987",ctaButton:"\u09ac\u09bf\u0995\u09cd\u09b0\u09af\u09bc\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8"},featuresPage:{title:"\u09b6\u0995\u09cd\u09a4\u09bf\u09b6\u09be\u09b2\u09c0",titleHighlight:"\u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af",subtitle:"\u09b8\u09ab\u09b2 \u09b9\u0993\u09af\u09bc\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09be\u09b0 \u09af\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8 \u09b8\u09ac",techSpecsTitle:"\u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09b8\u09cd\u09aa\u09c7\u09b8\u09bf\u09ab\u09bf\u0995\u09c7\u09b6\u09a8",workflowTitle:"\u098f\u099f\u09bf \u0995\u09bf\u09ad\u09be\u09ac\u09c7 \u0995\u09be\u099c \u0995\u09b0\u09c7",workflow:{s1:{title:"\u0986\u09ae\u09a6\u09be\u09a8\u09bf",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u0986\u09aa\u09b2\u09cb\u09a1 \u098f\u09ac\u0982 \u09b8\u0982\u0997\u09a0\u09bf\u09a4 \u0995\u09b0\u09c1\u09a8"},s2:{title:"\u0995\u09a8\u09ab\u09bf\u0997\u09be\u09b0 \u0995\u09b0\u09c1\u09a8",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u099b\u09a8\u09cd\u09a6 \u098f\u09ac\u0982 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09b8\u09c7\u099f \u0995\u09b0\u09c1\u09a8"},s3:{title:"\u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09c1\u09a8",description:"\u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09be\u09a7\u09be\u09a8 \u09a8\u09bf\u09af\u09bc\u09c7 \u09b2\u09be\u0987\u09ad \u09af\u09be\u09a8"},s4:{title:"\u09ae\u09a8\u09bf\u099f\u09b0 \u0995\u09b0\u09c1\u09a8",description:"\u0995\u09b0\u09cd\u09ae\u0995\u09cd\u09b7\u09ae\u09a4\u09be \u099f\u09cd\u09b0\u09cd\u09af\u09be\u0995 \u098f\u09ac\u0982 \u0985\u09aa\u09cd\u099f\u09bf\u09ae\u09be\u0987\u099c \u0995\u09b0\u09c1\u09a8"}},ctaTitle:"\u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u0985\u09a8\u09cd\u