d\u09a4\u09bf\u09a4 \u0995\u09a8\u09cd\u099f\u09c7\u09a8\u09cd\u099f\u09c7 \u09aa\u09c2\u09b0\u09cd\u09ac\u09a8\u09bf\u09b0\u09cd\u09a7\u09be\u09b0\u09bf\u09a4 \u099a\u09c7\u0995 \u099a\u09be\u09b2\u09be\u09af\u09bc\u0964 \u09a6\u09cd\u09b0\u09c1\u09a4 \u0993 \u0985\u09a8\u09c1\u09ae\u09be\u09a8\u09af\u09cb\u0997\u09cd\u09af, \u0995\u09cb\u09a8\u09cb AI \u0996\u09b0\u099a \u09a8\u09c7\u0987\u0964",aiAgentAudit:"AI \u098f\u099c\u09c7\u09a8\u09cd\u099f \u0985\u09a1\u09bf\u099f",aiAgentBadge:"AI-\u099a\u09be\u09b2\u09bf\u09a4 \u2022 \u09ac\u09c1\u09a6\u09cd\u09a7\u09bf\u09ae\u09be\u09a8 \u2022 \u09ac\u09be\u099c\u09c7\u099f \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7",aiAgentDescription:"\u09b8\u09cd\u09ac\u09be\u09af\u09bc\u09a4\u09cd\u09a4\u09b6\u09be\u09b8\u09bf\u09a4 AI \u098f\u099c\u09c7\u09a8\u09cd\u099f (Claude) \u0995\u09c0 \u099a\u09c7\u0995 \u0993 \u09a0\u09bf\u0995 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7 \u09b8\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09ac\u09c1\u09a6\u09cd\u09a7\u09bf\u09ae\u09be\u09a8 \u09b8\u09bf\u09a6\u09cd\u09a7\u09be\u09a8\u09cd\u09a4 \u09a8\u09c7\u09af\u09bc\u0964 \u0986\u09b0\u0993 \u09ac\u09cd\u09af\u09be\u09aa\u0995 \u0995\u09bf\u09a8\u09cd\u09a4\u09c1 API \u09ac\u09be\u099c\u09c7\u099f \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\u0964",triggerDaily:"\u09a6\u09c8\u09a8\u09bf\u0995 \u0985\u09a1\u09bf\u099f \u099a\u09be\u09b2\u09be\u09a8",triggerAI:"AI \u098f\u099c\u09c7\u09a8\u09cd\u099f \u0985\u09a1\u09bf\u099f \u099a\u09be\u09b2\u09be\u09a8",auditRunningNotice:"\u098f\u0995\u099f\u09bf \u0985\u09a1\u09bf\u099f \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u099a\u09b2\u099b\u09c7\u0964 \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u09b9\u09b2\u09c7 \u09ac\u09be\u099f\u09a8 \u09b8\u0995\u09cd\u09b7\u09ae \u09b9\u09ac\u09c7\u0964",budgetLabel:"AI \u098f\u099c\u09c7\u09a8\u09cd\u099f \u09ac\u09be\u099c\u09c7\u099f \u09b8\u09c0\u09ae\u09be: ${{budget}}",budgetPerAudit:"\u09aa\u0