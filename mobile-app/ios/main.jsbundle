093e\u090f\u0902",tmdbPostersOnly:"TMDB \u092a\u094b\u0938\u094d\u091f\u0930 \u0914\u0930 \u092e\u0947\u091f\u093e\u0921\u0947\u091f\u093e",tmdbPostersOnlyHelp:"TMDB \u0938\u0947 \u0917\u093e\u092f\u092c \u092a\u094b\u0938\u094d\u091f\u0930, \u0935\u093f\u0935\u0930\u0923 \u0914\u0930 \u092e\u0947\u091f\u093e\u0921\u0947\u091f\u093e \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902",openSubtitlesEnabled:"\u0909\u092a\u0936\u0940\u0930\u094d\u0937\u0915 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902",openSubtitlesEnabledHelp:"OpenSubtitles \u0938\u0947 \u0917\u093e\u092f\u092c \u0909\u092a\u0936\u0940\u0930\u094d\u0937\u0915 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 (HE/EN/ES)",classifyOnly:"\u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",classifyOnlyHelp:"\u092b\u093c\u093f\u0932\u094d\u092e \u092c\u0928\u093e\u092e \u0938\u0940\u0930\u0940\u091c\u093c \u0935\u0930\u094d\u0917\u0940\u0915\u0930\u0923 \u0924\u094d\u0930\u0941\u091f\u093f\u092f\u094b\u0902 \u0915\u0940 \u091c\u093e\u0902\u091a \u0914\u0930 \u0938\u0941\u0927\u093e\u0930 \u0915\u0930\u0947\u0902",purgeDuplicates:"\u0921\u0941\u092a\u094d\u0932\u093f\u0915\u0947\u091f \u0939\u091f\u093e\u090f\u0902",purgeDuplicatesHelp:"\u0921\u0941\u092a\u094d\u0932\u093f\u0915\u0947\u091f \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0906\u0907\u091f\u092e \u0916\u094b\u091c\u0947\u0902 \u0914\u0930 \u0939\u091f\u093e\u090f\u0902",auditType:"\u0911\u0921\u093f\u091f \u092a\u094d\u0930\u0915\u093e\u0930",auditTypeHelp:"\u0928\u093f\u092f\u092e-\u0906\u0927\u093e\u0930\u093f\u0924 \u092f\u093e AI-\u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0911\u0921\u093f\u091f \u0915\u0947 \u092c\u0940\u091a \u091a\u0941\u0928\u0947\u0902",dailyAudit:"\u0926\u0948\u0928\u093f\u0915 \u0911\u0921\u093f\u091f",dailyBadge:"\u0928\u093f\u092f\u092e-\u0906\u0927\u093e\u0930\u093f\u0924 \u2022 \u0924\u0