05dc\u05d9\u05d8\u05ea \u05ea\u05e8\u05d2\u05d5\u05dd \u05dc\u05dc\u05e7\u05d5\u05d7",input:"\u05e7\u05d8\u05e2 \u05d8\u05e7\u05e1\u05d8 \u05de\u05ea\u05d5\u05e8\u05d2\u05dd",output:"\u05d0\u05d9\u05e8\u05d5\u05e2 WebSocket \u05e2\u05dd \u05d8\u05e7\u05e1\u05d8 \u05de\u05ea\u05d5\u05e8\u05d2\u05dd"},tts:{title:"\u05e1\u05d9\u05e0\u05ea\u05d6\u05ea \u05d3\u05d9\u05d1\u05d5\u05e8 \u05d1\u05d6\u05e8\u05d9\u05de\u05d4 (\u05d7\u05d9\u05d1\u05d5\u05e8 \u05d7\u05d3\u05e9 \u05dc\u05db\u05dc \u05ea\u05de\u05dc\u05d5\u05dc)",input:"\u05d8\u05e7\u05e1\u05d8 \u05de\u05ea\u05d5\u05e8\u05d2\u05dd \u05dc\u05e1\u05d9\u05e0\u05ea\u05d6\u05ea \u05d3\u05d9\u05d1\u05d5\u05e8",output:"\u05e7\u05d8\u05e2\u05d9 \u05d0\u05d5\u05d3\u05d9\u05d5 \u05d1\u05d6\u05e8\u05d9\u05de\u05d4 \u05de-ElevenLabs"},encode:{title:"\u05e7\u05d9\u05d3\u05d5\u05d3 \u05d0\u05d5\u05d3\u05d9\u05d5 (base64)",input:"\u05de\u05d0\u05d2\u05e8 \u05d0\u05d5\u05d3\u05d9\u05d5 \u05d2\u05d5\u05dc\u05de\u05d9 \u05de-TTS",output:"\u05d0\u05d5\u05d3\u05d9\u05d5 \u05de\u05e7\u05d5\u05d3\u05d3 \u05d1-base64 \u05de\u05d5\u05db\u05df \u05dc\u05d4\u05e2\u05d1\u05e8\u05d4"},audioEmit:{title:"\u05e4\u05dc\u05d9\u05d8\u05ea \u05d0\u05d5\u05d3\u05d9\u05d5 \u05de\u05d3\u05d5\u05d1\u05d1",input:"\u05e7\u05d8\u05e2 \u05d0\u05d5\u05d3\u05d9\u05d5 \u05de\u05e7\u05d5\u05d3\u05d3",output:"\u05d0\u05d9\u05e8\u05d5\u05e2 WebSocket \u05e2\u05dd \u05e0\u05ea\u05d5\u05e0\u05d9 \u05d0\u05d5\u05d3\u05d9\u05d5 \u05de\u05d3\u05d5\u05d1\u05d1"}}},trivia:{nodes:{auth:{title:"\u05d0\u05d9\u05de\u05d5\u05ea WebSocket + \u05d4\u05d2\u05d1\u05dc\u05ea \u05e7\u05e6\u05d1",input:"\u05d1\u05e7\u05e9\u05ea \u05d7\u05d9\u05d1\u05d5\u05e8 WebSocket \u05e2\u05dd \u05d0\u05e1\u05d9\u05de\u05d5\u05df JWT",output:"\u05e1\u05e9\u05df \u05de\u05d0\u05d5\u05de\u05ea \u05e2\u05dd \u05d4\u05d2\u05d1\u05dc\u05ea \u05e7\u05e6\u05d1 \u05de\u05d5\u05e4\u05e2\u05dc\u05ea"},quota:{title:"\u05d1\u05d3\u05d9\u05e7\u05ea \u05de\u05db\u05e1\u05d4 (\u05de\u05d1\u05d5\u05e1\u05e1\u05ea \u05e2\u05d5\u05d1\u05d3\u05d5\u05ea)",input:"\u05de\u05d6\u05d4\u05d4 \u05de\u05e9\u05ea\u05de\u05e9 \u05d5\u05e1\u05d5\u05d2 \u05ea\u05db\u05d5\u05e0\u05ea \u05d8\u05e8\u05d9\u05d5\u05d5\u05d9\u05d4",output:"\u05d0\u05d9\u05de\u05d5\u05ea \u05de\u05db\u05e1\u05d4 (\u05d7\u05d9\u05d5\u05d1 \u05dc\u05e4\u05d9 \u05e2\u05d5\u05d1\u05d3\u05d4)"},topic:{title:"\u05d6\u05d9\u05d4\u05d5\u05d9 \u05e0\u05d5\u05e9\u05d0\u05d9\u05dd (NER)",input:"\u05d8\u05e7\u05e1\u05d8 \u05ea\u05de\u05dc\u05d5\u05dc \u05de\u05e2\u05e8\u05d5\u05e5 \u05d7\u05d9",output:"\u05d9\u05e9\u05d5\u05d9\u05d5\u05ea \u05d5\u05e0\u05d5\u05e9\u05d0\u05d9\u05dd \u05de\u05d6\u05d5\u05d4\u05d9\u05dd"},mention:{title:"\u05de\u05e2\u05e7\u05d1 \u05d0\u05d6\u05db\u05d5\u05e8\u05d9\u05dd (\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd 2, \u05e6\u05d9\u05e0\u05d5\u05df 60 \u05d3\u05e7\u05d5\u05ea)",input:"\u05d9\u05e9\u05d5\u05ea \u05de\u05d6\u05d5\u05d4\u05d4 \u05e2\u05dd \u05de\u05e1\u05e4\u05e8 \u05d0\u05d6\u05db\u05d5\u05e8\u05d9\u05dd",output:"\u05e0\u05d5\u05e9\u05d0 \u05d6\u05db\u05d0\u05d9 (2+ \u05d0\u05d6\u05db\u05d5\u05e8\u05d9\u05dd, \u05dc\u05d0 \u05d1\u05e6\u05d9\u05e0\u05d5\u05df)"},session:{title:"\u05e0\u05d9\u05d4\u05d5\u05dc \u05e1\u05e9\u05e0\u05d9\u05dd (FIFO \u05de\u05e7\u05e1\u05d9\u05de\u05d5\u05dd 100)",input:"\u05d1\u05e7\u05e9\u05ea \u05e1\u05e9\u05df \u05d8\u05e8\u05d9\u05d5\u05d5\u05d9\u05d4 \u05d7\u05d3\u05e9\u05d4",output:"\u05de\u05e9\u05d1\u05e6\u05ea \u05e1\u05e9\u05df \u05de\u05d5\u05e7\u05e6\u05d9\u05ea (\u05e4\u05d9\u05e0\u05d5\u05d9 FIFO \u05d1-100)"},cache:{title:"\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d1\u05de\u05d8\u05de\u05d5\u05df \u05e2\u05d5\u05d1\u05d3\u05d5\u05ea (TTL 24 \u05e9\u05e2\u05d5\u05ea)",input:"\u05d9\u05e9\u05d5\u05ea \u05e0\u05d5\u05e9\u05d0 \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e2\u05d5\u05d1\u05d3\u05d5\u05ea",output:"\u05e2\u05d5\u05d1\u05d3\u05d4 \u05de\u05d4\u05de\u05d8\u05de\u05d5\u05df \u05d0\u05dd \u05d6\u05de\u05d9\u05e0\u05d4 (TTL 24 \u05e9\u05e2\u05d5\u05ea)"},search:{title:"\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 (\u05d1\u05d4\u05d7\u05de\u05e6\u05ea \u05de\u05d8\u05de\u05d5\u05df \u05d1\u05dc\u05d1\u05d3)",input:"\u05d9\u05e9\u05d5\u05ea \u05e0\u05d5\u05e9\u05d0 \u05d4\u05d6\u05e7\u05d5\u05e7\u05d4 \u05dc\u05e2\u05d5\u05d1\u05d3\u05d5\u05ea \u05d7\u05d3\u05e9\u05d5\u05ea",output:"\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d7\u05d9\u05e4\u05d5\u05e9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05de-Tavily"},extract:{title:"\u05d7\u05d9\u05dc\u05d5\u05e5 \u05e2\u05d5\u05d1\u05d3\u05d5\u05ea (\u05d1\u05d4\u05d7\u05de\u05e6\u05ea \u05de\u05d8\u05de\u05d5\u05df \u05d1\u05dc\u05d1\u05d3)",input:"\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05d7\u05d9\u05e4\u05d5\u05e9 \u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05dc\u05e0\u05d5\u05e9\u05d0",output:"\u05e2\u05d5\u05d1\u05d3\u05ea \u05d8\u05e8\u05d9\u05d5\u05d5\u05d9\u05d4 \u05de\u05d5\u05d1\u05e0\u05d9\u05ea \u05e9\u05d7\u05d5\u05dc\u05e6\u05d4 \u05e2\u05dc \u05d9\u05d3\u05d9 AI"},tracking:{title:"\u05de\u05e2\u05e7\u05d1 \u05e1\u05e9\u05df + \u05de\u05e8\u05d5\u05d5\u05d7 (\u05de\u05d9\u05e0\u05d9\u05de\u05d5\u05dd 15 \u05e9\u05e0\u05d9\u05d5\u05ea)",input:"\u05e2\u05d5\u05d1\u05d3\u05ea \u05d8\u05e8\u05d9\u05d5\u05d5\u05d9\u05d4 \u05e9\u05e0\u05d5\u05e6\u05e8\u05d4",output:"\u05e2\u05d5\u05d1\u05d3\u05d4 \u05d1\u05ea\u05d5\u05e8 \u05e2\u05dd \u05de\u05e8\u05d5\u05d5\u05d7 \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9 \u05e9\u05dc 15 \u05e9\u05e0\u05d9\u05d5\u05ea"},emit:{title:"\u05e4\u05dc\u05d9\u05d8\u05ea \u05e2\u05d5\u05d1\u05d3\u05ea \u05d8\u05e8\u05d9\u05d5\u05d5\u05d9\u05d4 (\u05e8\u05d1-\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea)",input:"\u05e2\u05d5\u05d1\u05d3\u05ea \u05d8\u05e8\u05d9\u05d5\u05d5\u05d9\u05d4 \u05e2\u05dd \u05ea\u05e8\u05d2\u05d5\u05de\u05d9\u05dd",output:"\u05d0\u05d9\u05e8\u05d5\u05e2 WebSocket \u05e2\u05dd \u05d8\u05e8\u05d9\u05d5\u05d5\u05d9\u05d4 \u05e8\u05d1-\u05dc\u05e9\u05d5\u05e0\u05d9\u05ea"}}}},pending:{description:"\u05d4\u05ea\u05e9\u05dc\u05d5\u05dd \u05e9\u05dc\u05da \u05d1\u05e2\u05d9\u05d1\u05d5\u05d3. \u05d0\u05e0\u05d0 \u05d4\u05de\u05ea\u05df...",helpText:"\u05d6\u05d4 \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05dc\u05d5\u05e7\u05d7 \u05de\u05e1\u05e4\u05e8 \u05e9\u05e0\u05d9\u05d5\u05ea. \u05d0\u05dc \u05ea\u05e1\u05d2\u05d5\u05e8 \u05d3\u05e3 \u05d6\u05d4.",takingLonger:"\u05d6\u05d4 \u05dc\u05d5\u05e7\u05d7 \u05d9\u05d5\u05ea\u05e8 \u05d6\u05de\u05df \u05de\u05d4\u05e6\u05e4\u05d5\u05d9...",timeElapsed:"\u05d6\u05de\u05df \u05e9\u05d7\u05dc\u05e3: {{time}}",title:"\u05e2\u05d9\u05d1\u05d5\u05d3 \u05ea\u05e9\u05dc\u05d5\u05dd"},privacy:{children:{content:"\u05d1\u05e2\u05d5\u05d3 \u05e9\u05d4\u05ea\u05d5\u05db\u05df \u05e9\u05dc\u05e0\u05d5 \u05de\u05ea\u05d0\u05d9\u05dd \u05dc\u05db\u05dc \u05d4\u05d2\u05d9\u05dc\u05d0\u05d9\u05dd, Olorin.ai LLC \u05d0\u05d9\u05e0\u05d4 \u05d0\u05d5\u05e1\u05e4\u05ea \u05d1\u05d9\u05d5\u05d3\u05e2\u05d9\u05df \u05de\u05d9\u05d3\u05e2 \u05d0\u05d9\u05e9\u05d9 \u05de\u05d6\u05d4\u05d4 \u05de\u05d9\u05dc\u05d3\u05d9\u05dd \u05de\u05ea\u05d7\u05ea \u05dc\u05d2\u05d9\u05dc 13. \u05d0\u05dd \u05d0\u05ea\u05d4 \u05d4\u05d5\u05e8\u05d4 \u05d5\u05de\u05d0\u05de\u05d9\u05df \u05e9\u05d9\u05dc\u05d3\u05da \u05e1\u05d9\u05e4\u05e7 \u05dc\u05e0\u05d5 \u05de\u05d9\u05d3\u05e2 \u05d0\u05d9\u05e9\u05d9, \u05d0\u05e0\u05d0 \u05e6\u05d5\u05e8 \u05d0\u05d9\u05ea\u05e0\u05d5 \u05e7\u05e9\u05e8.",title:"5. \u05d9\u05dc\u05d3\u05d9\u05dd"},collection:{audio:{data:"\u05de\u05d9\u05d3\u05e2 \u05e9\u05e0\u05d0\u05e1\u05e3: \u05d3\u05d2\u05d9\u05de\u05d5\u05ea \u05e9\u05de\u05e2 \u05e7\u05e6\u05e8\u05d5\u05ea \u05e9\u05dc \u05e9\u05d9\u05d3\u05d5\u05e8 \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4.",intro:"\u05d0\u05dd \u05d0\u05ea\u05d4 \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d4\u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05e9\u05de\u05e2, \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d1\u05e7\u05e9 \u05d2\u05d9\u05e9\u05d4 \u05dc\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df.",purpose:"\u05de\u05d8\u05e8\u05d4: \u05dc\u05d4\u05ea\u05d0\u05d9\u05dd \u05d0\u05ea \u05d8\u05d1\u05d9\u05e2\u05ea \u05d4\u05d0\u05e6\u05d1\u05e2 \u05d4\u05e7\u05d5\u05dc\u05d9\u05ea \u05e9\u05dc \u05d4\u05e9\u05d9\u05d3\u05d5\u05e8 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9 \u05dc\u05de\u05d8\u05e8\u05d5\u05ea \u05e1\u05e0\u05db\u05e8\u05d5\u05df.",retention:"\u05e9\u05de\u05d9\u05e8\u05d4: \u05db\u05de\u05d5 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d7\u05d6\u05d5\u05ea\u05d9\u05d9\u05dd, \u05d3\u05d2\u05d9\u05de\u05d5\u05ea \u05e9\u05de\u05e2 \u05de\u05e2\u05d5\u05d1\u05d3\u05d5\u05ea \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea \u05d5\u05e0\u05de\u05d7\u05e7\u05d5\u05ea \u05de\u05d9\u05d3. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05dc\u05d0 \u05de\u05d0\u05d6\u05d9\u05e0\u05d9\u05dd \u05d0\u05d5 \u05de\u05e7\u05dc\u05d9\u05d8\u05d9\u05dd \u05e9\u05d9\u05d7\u05d5\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd.",title:"\u05d1. \u05e0\u05ea\u05d5\u05e0\u05d9 \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05e9\u05de\u05e2"},camera:{data:"\u05de\u05d9\u05d3\u05e2 \u05e9\u05e0\u05d0\u05e1\u05e3: \u05e4\u05e8\u05d9\u05d9\u05de\u05d9\u05dd \u05d1\u05d5\u05d3\u05d3\u05d9\u05dd \u05d1\u05e8\u05d6\u05d5\u05dc\u05d5\u05e6\u05d9\u05d4 \u05e0\u05de\u05d5\u05db\u05d4 \u05e9\u05dc \u05de\u05e1\u05da \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05e9\u05dc\u05da.",intro:"\u05db\u05d3\u05d9 \u05dc\u05e1\u05e4\u05e7 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05de\u05e8\u05db\u05d6\u05d9 \u05e9\u05dc\u05e0\u05d5 - \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05e9\u05de\u05e2 \u05de\u05ea\u05d5\u05e8\u05d2\u05dd \u05e2\u05dd \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05e9\u05dc\u05da - \u05d1\u05d9\u05ea+ \u05d3\u05d5\u05e8\u05e9 \u05d2\u05d9\u05e9\u05d4 \u05dc\u05de\u05e6\u05dc\u05de\u05ea \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05e9\u05dc\u05da.",purpose:"\u05de\u05d8\u05e8\u05d4: \u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05ea\u05d5\u05db\u05df \u05d4\u05de\u05e9\u05d5\u05d3\u05e8 \u05d1\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05e9\u05dc\u05da \u05dc\u05e6\u05d5\u05e8\u05da \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05de\u05d3\u05d5\u05d9\u05e7.",retention:"\u05e9\u05de\u05d9\u05e8\u05d4: \u05e0\u05ea\u05d5\u05df \u05d6\u05d4 \u05d6\u05de\u05e0\u05d9. \u05d4\u05e4\u05e8\u05d9\u05d9\u05de\u05d9\u05dd \u05de\u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05de\u05d9\u05d3 \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d5\u05e0\u05de\u05d7\u05e7\u05d9\u05dd \u05dc\u05e6\u05de\u05d9\u05ea\u05d5\u05ea \u05de\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05d1\u05d9\u05e1\u05d5\u05e1 \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05dc\u05d0 \u05e6\u05d5\u05e4\u05d9\u05dd, \u05e9\u05d5\u05de\u05e8\u05d9\u05dd \u05d0\u05d5 \u05de\u05d0\u05d7\u05e1\u05e0\u05d9\u05dd \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc \u05d4\u05d1\u05d9\u05ea \u05d0\u05d5 \u05d4\u05de\u05e9\u05e4\u05d7\u05d4 \u05e9\u05dc\u05da.",title:"\u05d0. \u05e0\u05ea\u05d5\u05e0\u05d9 \u05de\u05e6\u05dc\u05de\u05d4 \u05d5\u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d7\u05d6\u05d5\u05ea\u05d9"},title:"2. \u05de\u05d9\u05d3\u05e2 \u05e9\u05d0\u05e0\u05d5 \u05d0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d5\u05d0\u05d9\u05da \u05d0\u05e0\u05d5 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05d5",usage:{aggregate:"\u05e0\u05ea\u05d5\u05e0\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05de\u05e6\u05d8\u05d1\u05e8\u05d9\u05dd \u05d5\u05d0\u05e0\u05d5\u05e0\u05d9\u05de\u05d9\u05d9\u05dd",content:"\u05d0\u05e0\u05d5 \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d0\u05e1\u05d5\u05e3 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d8\u05db\u05e0\u05d9\u05d9\u05dd \u05dc\u05d0 \u05de\u05d6\u05d4\u05d9\u05dd \u05dc\u05e9\u05d9\u05e4\u05d5\u05e8 \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4, \u05db\u05d5\u05dc\u05dc:",crash:"\u05d9\u05d5\u05de\u05e0\u05d9 \u05e7\u05e8\u05d9\u05e1\u05d4 \u05d5\u05de\u05d3\u05d3\u05d9 \u05d1\u05d9\u05e6\u05d5\u05e2\u05d9\u05dd.",device:"\u05e1\u05d5\u05d2 \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05d5\u05d2\u05e8\u05e1\u05ea \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4.",title:"\u05d2. \u05e0\u05ea\u05d5\u05e0\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d5\u05d8\u05db\u05e0\u05d9\u05d9\u05dd"}},contact:{intro:"\u05d0\u05dd \u05d9\u05e9 \u05dc\u05da \u05e9\u05d0\u05dc\u05d5\u05ea \u05dc\u05d2\u05d1\u05d9 \u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d6\u05d5, \u05d0\u05e0\u05d0 \u05e6\u05d5\u05e8 \u05d0\u05d9\u05ea\u05e0\u05d5 \u05e7\u05e9\u05e8 \u05d1\u05db\u05ea\u05d5\u05d1\u05ea:",title:"7. \u05e6\u05d5\u05e8 \u05e7\u05e9\u05e8"},intro:{commitment:"\u05d1\u05e0\u05d9\u05e0\u05d5 \u05d0\u05ea \u05d1\u05d9\u05ea+ \u05e2\u05dd \u05d0\u05e8\u05db\u05d9\u05d8\u05e7\u05d8\u05d5\u05e8\u05ea \"\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05e7\u05d5\u05d3\u05dd \u05db\u05dc\". \u05d0\u05e0\u05d7\u05e0\u05d5 \u05dc\u05d0 \u05de\u05e6\u05dc\u05de\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05dc\u05d5\u05df \u05e9\u05dc\u05da. \u05d4\u05d8\u05db\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc\u05e0\u05d5 \u05de\u05e9\u05ea\u05de\u05e9\u05ea \u05d1\u05de\u05db\u05e9\u05d9\u05e8 \u05e9\u05dc\u05da \u05dc\u05e2\u05d9\u05d1\u05d5\u05d3 \u05de\u05e7\u05d5\u05de\u05d9 \u05d1\u05dc\u05d1\u05d3.",content:"\u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d6\u05d5 \u05de\u05ea\u05d0\u05e8\u05ea \u05db\u05d9\u05e6\u05d3 Olorin.ai LLC \u05d0\u05d5\u05e1\u05e4\u05ea, \u05de\u05e9\u05ea\u05de\u05e9\u05ea \u05d5\u05de\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05de\u05d9\u05d3\u05e2 \u05e9\u05dc\u05da.",title:"1. \u05de\u05d1\u05d5\u05d0"},lastUpdated:"\u05e2\u05d3\u05db\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df: 27 \u05d1\u05d9\u05e0\u05d5\u05