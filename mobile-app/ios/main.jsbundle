1\u05d9\u05d3\u05d5\u05e8",culture:"\ud83c\udfad \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9 \u05ea\u05e8\u05d1\u05d5\u05ea",music:"\ud83c\udfb5 \u05de\u05d5\u05d6\u05d9\u05e7\u05d4 \u05d5\u05e7\u05d5\u05e0\u05e6\u05e8\u05d8\u05d9\u05dd",food:"\ud83c\udf74 \u05d0\u05d5\u05db\u05dc \u05d5\u05de\u05e1\u05e2\u05d3\u05d5\u05ea",tech:"\ud83d\udcbb \u05d8\u05db\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05d5\u05d7\u05d3\u05e9\u05e0\u05d5\u05ea",events:"\ud83d\udcc5 \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd \u05de\u05e7\u05d5\u05de\u05d9\u05d9\u05dd"}},privacy:{lastUpdated:"\u05e2\u05d3\u05db\u05d5\u05df \u05d0\u05d7\u05e8\u05d5\u05df: 27 \u05d1\u05d9\u05e0\u05d5\u05d0\u05e8 2026",intro:{title:"1. \u05de\u05d1\u05d5\u05d0",content:"Olorin.ai LLC (\"\u05d0\u05e0\u05d7\u05e0\u05d5\", \"\u05e9\u05dc\u05e0\u05d5\" \u05d0\u05d5 \"\u05d4\u05d7\u05d1\u05e8\u05d4\") \u05de\u05d7\u05d5\u05d9\u05d1\u05ea \u05dc\u05d4\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05e9\u05dc\u05da. \u05de\u05d3\u05d9\u05e0\u05d9\u05d5\u05ea \u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d6\u05d5 \u05de\u05e1\u05d1\u05d9\u05e8\u05d4 \u05db\u05d9\u05e6\u05d3 \u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d9\u05ea \u05d4\u05de\u05d5\u05d1\u05d9\u05d9\u05dc \u05e9\u05dc\u05e0\u05d5, Bayit+ (\"\u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4\"), \u05d0\u05d5\u05e1\u05e4\u05ea, \u05de\u05e9\u05ea\u05de\u05e9\u05ea \u05d5\u05de\u05d2\u05e0\u05d4 \u05e2\u05dc \u05d4\u05de\u05d9\u05d3\u05e2 \u05e9\u05dc\u05da.",commitment:"\u05d1\u05e0\u05d9\u05e0\u05d5 \u05d0\u05ea Bayit+ \u05e2\u05dd \u05d0\u05e8\u05db\u05d9\u05d8\u05e7\u05d8\u05d5\u05e8\u05ea \"\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea-\u05e7\u05d5\u05d3\u05dd\". \u05d0\u05e0\u05d7\u05e0\u05d5 \u05dc\u05d0 \u05de\u05e7\u05dc\u05d9\u05d8\u05d9\u05dd \u05d0\u05ea \u05d4\u05e1\u05dc\u05d5\u05df \u05e9\u05dc\u05da. \u05d4\u05d8\u05db\u05e0\u05d5\u05dc\u05d5\u05d2\u05d9\u05d4 \u05e9\u05dc\u05e0\u05d5 \u05de\u05e9\u05ea\u05de\u05e9\u05ea \u05d1\u05d7\u05d9\u05d9\u05e9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05e9\u05dc\u05da \u05d0\u05da \u05d5\u05e8\u05e7 \u05db\u05d3\u05d9 \u05dc\u05e1\u05e0\u05db\u05e8\u05df \u05d0\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05e9\u05de\u05e2 \u05e9\u05dc\u05e0\u05d5 \u05e2\u05dd \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05e9\u05dc\u05da."},collection:{title:"2. \u05de\u05d9\u05d3\u05e2 \u05e9\u05d0\u05e0\u05d5 \u05d0\u05d5\u05e1\u05e4\u05d9\u05dd \u05d5\u05db\u05d9\u05e6\u05d3 \u05d0\u05e0\u05d5 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05d5",camera:{title:"\u05d0. \u05de\u05e6\u05dc\u05de\u05d4 \u05d5\u05e0\u05ea\u05d5\u05e0\u05d9 \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9",intro:"\u05db\u05d3\u05d9 \u05dc\u05e1\u05e4\u05e7 \u05d0\u05ea \u05d4\u05e9\u05d9\u05e8\u05d5\u05ea \u05d4\u05dc\u05d9\u05d1\u05d4 \u05e9\u05dc\u05e0\u05d5 - \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05e9\u05de\u05e2 \u05de\u05ea\u05d5\u05e8\u05d2\u05dd \u05e2\u05dd \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05e9\u05dc\u05da - Bayit+ \u05d3\u05d5\u05e8\u05e9\u05ea \u05d2\u05d9\u05e9\u05d4 \u05dc\u05de\u05e6\u05dc\u05de\u05d4 \u05e9\u05dc \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05e9\u05dc\u05da.",data:"\u05de\u05d9\u05d3\u05e2 \u05e9\u05e0\u05d0\u05e1\u05e3: \u05db\u05d0\u05e9\u05e8 \u05d0\u05ea\u05d4 \u05de\u05e4\u05e2\u05d9\u05dc \"\u05de\u05e6\u05d1 \u05e1\u05e0\u05db\u05e8\u05d5\u05df\", \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05de\u05e6\u05dc\u05de\u05ea \u05e8\u05e6\u05e3 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05e4\u05e8\u05d9\u05d9\u05de\u05d9 \u05d5\u05d9\u05d3\u05d0\u05d5 (\u05db-3 \u05e9\u05e0\u05d9\u05d5\u05ea) \u05de\u05de\u05e1\u05da \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05e9\u05dc\u05da.",purpose:"\u05de\u05d8\u05e8\u05d4: \u05e4\u05e8\u05d9\u05d9\u05de\u05d9\u05dd \u05d0\u05dc\u05d4 \u05de\u05d5\u05e2\u05d1\u05e8\u05d9\u05dd \u05dc\u05e9\u05e8\u05ea \u05d4\u05e2\u05e0\u05df \u05d4\u05de\u05d0\u05d5\u05d1\u05d8\u05d7 \u05e9\u05dc\u05e0\u05d5 \u05d0\u05da \u05d5\u05e8\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d6\u05d4\u05d5\u05ea \u05d0\u05ea \u05e2\u05e8\u05d5\u05e5 \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9 \u05e9\u05d0\u05ea\u05d4 \u05e6\u05d5\u05e4\u05d4 \u05d1\u05d5 \u05d5\u05dc\u05d7\u05e9\u05d1 \u05d0\u05ea \u05d4\u05e9\u05d4\u05d9\u05d9\u05ea \u05d4\u05e9\u05d9\u05d3\u05d5\u05e8 (\u05e2\u05d9\u05db\u05d5\u05d1 \u05d6\u05de\u05df).",retention:"\u05e9\u05de\u05d9\u05e8\u05d4: \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d0\u05dc\u05d4 \u05d4\u05dd \u05d6\u05de\u05e0\u05d9\u05d9\u05dd. \u05d4\u05e4\u05e8\u05d9\u05d9\u05de\u05d9\u05dd \u05de\u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05de\u05d9\u05d3 \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d5\u05e0\u05de\u05d7\u05e7\u05d9\u05dd \u05dc\u05e6\u05de\u05d9\u05ea\u05d5\u05ea \u05de\u05d9\u05d3 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05e7\u05de\u05ea \u05d4\u05e1\u05e0\u05db\u05e8\u05d5\u05df. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05dc\u05d0 \u05e8\u05d5\u05d0\u05d9\u05dd, \u05e9\u05d5\u05de\u05e8\u05d9\u05dd \u05d0\u05d5 \u05de\u05d0\u05e8\u05db\u05d9\u05d1\u05d9\u05dd \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc \u05d4\u05d1\u05d9\u05ea \u05d0\u05d5 \u05d4\u05de\u05e9\u05e4\u05d7\u05d4 \u05e9\u05dc\u05da."},audio:{title:"\u05d1. \u05e0\u05ea\u05d5\u05e0\u05d9 \u05d0\u05d5\u05d3\u05d9\u05d5 (\u05d0\u05dd \u05d9\u05e9\u05d9\u05dd)",intro:"\u05d0\u05dd \u05d0\u05ea\u05d4 \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05ea\u05db\u05d5\u05e0\u05d5\u05ea \u05d4\u05d3\u05d5\u05e8\u05e9\u05d5\u05ea \u05e1\u05e0\u05db\u05e8\u05d5\u05df \u05d0\u05d5\u05d3\u05d9\u05d5, \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e2\u05e9\u05d5\u05d9\u05d4 \u05dc\u05d1\u05e7\u05e9 \u05d2\u05d9\u05e9\u05d4 \u05dc\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df.",data:"\u05de\u05d9\u05d3\u05e2 \u05e9\u05e0\u05d0\u05e1\u05e3: \u05d3\u05d2\u05d9\u05de\u05d5\u05ea \u05d0\u05d5\u05d3\u05d9\u05d5 \u05e7\u05e6\u05e8\u05d5\u05ea \u05e9\u05dc \u05e9\u05d9\u05d3\u05d5\u05e8 \u05d4\u05d8\u05dc\u05d5\u05d5\u05d9\u05d6\u05d9\u05d4.",purpose:"\u05de\u05d8\u05e8\u05d4: \u05dc\u05d4\u05ea\u05d0\u05de\u05ea \u05d8\u05d1\u05d9\u05e2\u05ea \u05d4\u05d0\u05e6\u05d1\u05e2 \u05d4\u05d0\u05d5\u05d3\u05d9\u05d5 \u05e9\u05dc \u05d4\u05e9\u05d9\u05d3\u05d5\u05e8 \u05d4\u05e6\u05d9\u05d1\u05d5\u05e8\u05d9 \u05dc\u05de\u05d8\u05e8\u05d5\u05ea \u05e1\u05e0\u05db\u05e8\u05d5\u05df.",retention:"\u05e9\u05de\u05d9\u05e8\u05d4: \u05db\u05de\u05d5 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9\u05d9\u05dd, \u05d3\u05d2\u05d9\u05de\u05d5\u05ea \u05d4\u05d0\u05d5\u05d3\u05d9\u05d5 \u05de\u05e2\u05d5\u05d1\u05d3\u05d5\u05ea \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea \u05d5\u05e0\u05de\u05d7\u05e7\u05d5\u05ea \u05de\u05d9\u05d3. \u05d0\u05e0\u05d7\u05e0\u05d5 \u05dc\u05d0 \u05de\u05d0\u05d6\u05d9\u05e0\u05d9\u05dd \u05d0\u05d5 \u05de\u05e7\u05dc\u05d9\u05d8\u05d9\u05dd \u05e9\u05d9\u05d7\u05d5\u05ea \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd."},usage:{title:"\u05d2. \u05e0\u05ea\u05d5\u05e0\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d5\u05d8\u05db\u05e0\u05d9\u05d9\u05dd",content:"\u05d0\u05e0\u05d5 \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d0\u05e1\u05d5\u05e3 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d8\u05db\u05e0\u05d9\u05d9\u05dd \u05dc\u05d0 \u05de\u05d6\u05d4\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d9\u05e6\u05d9\u05d1\u05d5\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4, \u05db\u05d5\u05dc\u05dc:",device:"\u05e1\u05d5\u05d2 \u05de\u05db\u05e9\u05d9\u05e8 \u05d5\u05d2\u05e8\u05e1\u05ea \u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e4\u05e2\u05dc\u05d4.",crash:"\u05d9\u05d5\u05de\u05e0\u05d9 \u05e7\u05e8\u05d9\u05e1\u05d4 \u05d5\u05de\u05d3\u05d3\u05d9 \u05d1\u05d9\u05e6\u05d5\u05e2\u05d9\u05dd.",aggregate:"\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05de\u05e6\u05d8\u05d1\u05e8\u05d9\u05dd \u05e2\u05dc \u05d0\u05d9\u05dc\u05d5 \u05e2\u05e8\u05d5\u05e6\u05d9\u05dd \u05e0\u05e6\u05e4\u05d9\u05dd (\u05dc\u05de\u05e9\u05dc, \"50% \u05de\u05d4\u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05e6\u05d5\u05e4\u05d9\u05dd \u05d1\u05e2\u05e8\u05d5\u05e5 12\")."}},sharing:{title:"3. \u05e9\u05d9\u05ea\u05d5\u05e3 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d5\u05e6\u05d3\u05d3\u05d9\u05dd \u05e9\u05dc\u05d9\u05e9\u05d9\u05d9\u05dd",noSale:"Olorin.ai LLC \u05dc\u05d0 \u05de\u05d5\u05db\u05e8\u05ea \u05d0\u05ea \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05d0\u05d9\u05e9\u05d9\u05d9\u05dd \u05e9\u05dc\u05da. \u05d0\u05e0\u05d5 \u05de\u05e9\u05ea\u05e4\u05d9\u05dd \u05e4\u05e2\u05d5\u05dc\u05d4 \u05e2\u05dd \u05e1\u05e4\u05e7\u05d9 \u05e9\u05d9\u05e8\u05d5\u05ea \u05e6\u05d3 \u05e9\u05dc\u05d9\u05e9\u05d9 \u05de\u05d4\u05d9\u05de\u05e0\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05e1\u05e4\u05e7 \u05d0\u05ea \u05d4\u05ea\u05e9\u05ea\u05d9\u05ea \u05e9\u05dc\u05e0\u05d5. \u05e1\u05e4\u05e7\u05d9\u05dd \u05d0\u05dc\u05d4 \u05de\u05d5\u05e8\u05e9\u05d9\u05dd \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05da \u05e8\u05e7 \u05db\u05db\u05dc \u05d4\u05e0\u05d3\u05e8\u05e9 \u05db\u05d3\u05d9 \u05dc\u05e1\u05e4\u05e7 \u05dc\u05e0\u05d5 \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05d0\u05dc\u05d4:",cloud:"\u05ea\u05e9\u05ea\u05d9\u05ea \u05e2\u05e0\u05df: \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9 \u05d0\u05d9\u05e8\u05d5\u05d7 (\u05dc\u05de\u05e9\u05dc, AWS) \u05dc\u05e2\u05d9\u05d1\u05d5\u05d3 \u05d1\u05e7\u05e9\u05d5\u05ea \u05e1\u05e0\u05db\u05e8\u05d5\u05df.",ai:"\u05e2\u05d9\u05d1\u05d5\u05d3 AI: \u05e9\u05d9\u05e8\u05d5\u05ea\u05d9\u05dd \u05d4\u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05dc\u05d9\u05e6\u05d9\u05e8\u05ea \u05ea\u05e8\u05d2\u05d5\u05de\u05d9 \u05d8\u05e7\u05e1\u05d8 \u05d5\u05d0\u05d5\u05d3\u05d9\u05d5 \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea \u05de\u05e4\u05d9\u05d3\u05d9\u05dd \u05e9\u05dc \u