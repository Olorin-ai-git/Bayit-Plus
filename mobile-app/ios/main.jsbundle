eader} mancante",capability_disabled:"La funzionalit\xe0 '{capability}' \xe8 attualmente disabilitata",capability_not_enabled:"La funzionalit\xe0 '{capability}' non \xe8 abilitata per questo partner",source_language_not_supported:"Lingua sorgente '{language}' non supportata. Supportate: {supported}",target_language_not_supported:"Lingua destinazione '{language}' non supportata. Supportate: {supported}",partner_not_found:"Partner non trovato",partner_registration_failed:"Registrazione partner fallita",no_updates_provided:"Nessun aggiornamento fornito",webhook_config_failed:"Configurazione webhook fallita",webhook_url_not_configured:"URL webhook non configurato",webhook_secret_not_configured:"Secret webhook non configurato",search_failed:"Ricerca fallita",indexing_failed:"Indicizzazione fallita",detection_failed:"Rilevamento fallito",explanation_failed:"Impossibile ottenere spiegazione",reference_not_found:"Riferimento '{reference_id}' non trovato",enrichment_failed:"Arricchimento fallito",get_references_failed:"Impossibile ottenere riferimenti",create_session_failed:"Impossibile creare sessione",add_transcript_failed:"Impossibile aggiungere trascrizione",generate_recap_failed:"Impossibile generare riepilogo"}},cities:{jerusalem:{title:"Gerusalemme",subtitle:"Scopri la citt\xe0 eterna",loadingContent:"Caricamento contenuti di Gerusalemme...",noContent:"Nessun contenuto disponibile al momento",errorLoading:"Impossibile caricare i contenuti di Gerusalemme",sources:"Fonti",categories:{history:"\ud83c\udfdb\ufe0f Siti storici",religion:"\ud83d\udd4d Patrimonio religioso",culture:"\ud83c\udfad Eventi culturali",events:"\ud83d\udcc5 Eventi locali",food:"\ud83c\udf74 Delizie culinarie",markets:"\ud83d\udecd\ufe0f Mercati tradizionali",arts:"\ud83c\udfa8 Arte e Gallerie"}},telAviv:{title:"Tel Aviv",subtitle:"Vivi la citt\xe0 vibrante",loadingContent:"Caricamento contenuti di Tel Aviv...",noContent:"Nessun contenuto disponibile al momento",errorLoading:"Impossibile caricare i contenuti di Tel Aviv",sources:"Fonti",categories:{beaches:"\ud83c\udfd6\ufe0f Spiagge e Lungomare",nightlife:"\ud83c\udf03 Vita notturna e Intrattenimento",culture:"\ud83c\udfad Eventi culturali",music:"\ud83c\udfb5 Musica e Concerti",food:"\ud83c\udf74 Gastronomia",tech:"\ud83d\udcbb Tech e Innovazione",events:"\ud83d\udcc5 Eventi locali"}},beta:{credits:{loading:"Caricamento saldo crediti...",error:"Impossibile caricare il saldo crediti",label:"Crediti IA",remaining:"Crediti rimanenti",warningCritical:"Critico: Crediti quasi esauriti",warningLow:"Avviso: Saldo crediti basso",upgrade:"Aggiorna piano",upgradeAction:"Aggiorna per ottenere pi\xf9 crediti"},settings:{title:"Programmi Beta",description:"Gestisci la tua iscrizione a Beta 500 e visualizza i dettagli del programma. Ottieni accesso anticipato alle funzionalit\xe0 basate sull'IA.",enrolledTitle:"Sei in Beta 500!",statusPendingVerification:"Verifica in corso",statusActive:"Attivo",statusExpired:"Scaduto",pendingMessage:"Stiamo verificando la tua iscrizione. Riceverai un'email una volta approvata.",expiresOn:"Scade il {{date}}",loadingStatus:"Caricamento stato programma...",errorLoading:"Impossibile caricare le informazioni del programma. Riprova.",programStatus:"Stato programma",slots:"posti occupati",slotsAvailable:"{{count}} posti disponibili",programFull:"Tutti i 500 posti occupati"},enrollment:{title:"Unisciti a Beta 500",subtitle:"Sii una delle 500 famiglie a sperimentare le funzionalit\xe0 basate sull'IA",programFull:"Programma completo",joinButton:"Unisciti a Beta 500",exclusiveAccess:"Accesso esclusivo",limitedSlots:"Limitato a 500 famiglie",slotsAvailable:"{{available}} di {{total}} posti disponibili",freeCredits:"Crediti IA gratuiti",creditsAmount:"5.000 crediti (valore 50\u20ac)",duration:"Durata Beta",durationValue:"90 giorni",features:"Funzionalit\xe0 IA",featuresValue:"Doppiaggio live, ricerca IA, raccomandazioni",whatYouGet:"Cosa ottieni",benefits:{liveDubbing:"Traduzione audio in tempo reale mentre guardi",aiSearch:"Scoperta intelligente dei contenuti",aiRecommendations:"Suggerimenti personalizzati",prioritySupport:"Accesso diretto al team di sviluppo"},disclaimer:"Beta 500 \xe8 un programma a tempo limitato. I crediti non sono rinnovabili durante il periodo beta.",waitlistMessage:"Tutti i 500 posti sono attualmente occupati. Unisciti alla lista d'attesa per essere avvisato quando un posto si libera.",enrollmentSuccess:"Benvenuto in Beta 500! Controlla la tua email per verificare l'account.",enrollmentError:"Impossibile iscriversi. Riprova pi\xf9 tardi."}},privacy:{lastUpdated:"Ultimo aggiornamento: 27 gennaio 2026",intro:{title:"1. Introduzione",content:"Olorin.ai LLC (\"noi,\" \"nostro,\" o \"la Societ\xe0\") si impegna a proteggere la tua privacy. Questa Informativa sulla Privacy spiega come la nostra applicazione mobile, Bayit+ (l'\"App\"), raccoglie, utilizza e protegge le tue informazioni.",commitment:"Abbiamo costruito Bayit+ con un'architettura \"Privacy-First\". Non registriamo il tuo soggiorno. La nostra tecnologia utilizza i sensori del tuo dispositivo esclusivamente per sincronizzare il nostro servizio audio con il tuo televisore."},collection:{title:"2. Informazioni che raccogliamo e come le utilizziamo",camera:{title:"A. Dati di sincronizzazione visiva e fotocamera",intro:"Per fornire il nostro servizio principale\u2014sincronizzare l'audio tradotto con la tua TV\u2014Bayit+ richiede l'accesso alla fotocamera del tuo dispositivo.",data:"Dati raccolti: Quando attivi la \"Modalit\xe0 sincronizzazione\", l'App cattura una breve sequenza di fotogrammi video (circa 3 secondi) dallo schermo della tua TV.",purpose:"Scopo: Questi fotogrammi vengono trasmessi al nostro server cloud sicuro esclusivamente per identificare il canale TV pubblico che stai guardando e calcolare la latenza della trasmissione (ritardo temporale).",retention:"Conservazione: Questi dati sono effimeri. I fotogrammi vengono elaborati istantaneamente in memoria e vengono eliminati permanentemente immediatamente dopo che la sincronizzazione \xe8 stata stabilita. Non visualizziamo, memorizziamo o archiviamo immagini della tua casa o della tua famiglia."},audio:{title:"B. Dati audio (se applicabile)",intro:"Se utilizzi funzionalit\xe0 che richiedono la sincronizzazione audio, l'App potrebbe richiedere l'accesso al microfono.",data:"Dati raccolti: Brevi campioni audio della trasmissione TV.",purpose:"Scopo: Per abbinare l'impronta audio della trasmissione pubblica ai fini della sincronizzazione.",retention:"Conservazione: Come i dati visivi, i campioni audio vengono elaborati in tempo reale e immediatamente eliminati. Non ascoltiamo o registriamo le conversazioni degli utenti."},usage:{title:"C. Dati di utilizzo e tecnici",content:"Potremmo raccogliere dati tecnici non identificabili per migliorare la stabilit\xe0 dell'App, inclusi:",device:"Tipo di dispositivo e versione del sistema operativo.",crash:"Log di crash e metriche di prestazione.",aggregate:'Dati aggregati su quali canali vengono guardati (es. "Il 50% degli utenti sta guardando Canale 12").'}},sharing:{title:"3. Condivisione dati e terze parti",noSale:"Olorin.ai LLC non vende i tuoi dati personali. Collaboriamo con fornitori di servizi terzi affidabili per fornire la nostra infrastruttura. Questi fornitori sono autorizzati a utilizzare i tuoi dati solo come necessario per fornire questi servizi a noi:",cloud:"Infrastruttura cloud: Servizi di hosting (es. AWS) per elaborare le richieste di sincronizzazione.",ai:"Elaborazione IA: Servizi utilizzati per generare traduzioni di testo e audio in tempo reale da trasmissioni pubbliche."},retention:{title:"4. Conservazione dei dati",sync:"Dati di sincronizzazione (immagini/audio): 0 giorni. Eliminati immediatamente dopo l'elaborazione.",account:"Dati dell'account: Conservati solo finch\xe9 il tuo account \xe8 attivo per gestire il tuo abbonamento e le preferenze."},children:{title:"5. Privacy dei minori",content:"Sebbene i nostri contenuti siano adatti a tutte le et\xe0, Olorin.ai LLC non raccoglie consapevolmente informazioni personali identificabili da bambini di et\xe0 inferiore ai 13 anni. Se sei un genitore e ritieni che tuo figlio ci abbia fornito informazioni personali, contattaci."},rights:{title:"6. I tuoi diritti",content:"A seconda della tua posizione, potresti avere il diritto di richiedere l'accesso, la correzione o la cancellazione dei tuoi dati personali. Puoi eliminare il tuo account Bayit+ in qualsiasi momento dalle impostazioni dell'App."},contact:{title:"7. Contattaci",intro:"Per qualsiasi domanda su questa Informativa sulla Privacy, contattaci a:"}}},quota:{subtitleExceeded:"Quota sottotitoli superata. Riprova pi\xf9 tardi.",dubbingExceeded:"Quota doppiaggio superata. Riprova pi\xf9 tardi."},validation:{authorRequired:"L'autore \xe8 obbligatorio",orderRange:"L'ordine deve essere compreso tra 1 e 100",streamUrlRequired:"L'URL dello stream \xe8 obbligatorio",titleRequired:"Il titolo \xe8 obbligatorio"},audible:{accountLinked:"Il tuo account Audible \xe8 ora collegato a Bayit+",connected:"Connesso!",connecting:"Connessione ad Audible...",connectionFailed:"Connessione fallita",pleaseWait:"Attendere mentre colleghiamo il tuo account.",connect:"Connetti Audible",disconnect:"Disconnetti Audible"},cancelled:{description:"Il tuo pagamento \xe8 stato annullato.",helpText:"Nessun addebito \xe8 stato effettuato sul tuo account.",retry:"Riprova",title:"Pagamento annullato"},devices:{activeNow:"Attivo ora",confirmDisconnect:"Disconnettere il dispositivo?",daysAgo:"{{count}} giorni fa",disconnect:"Disconnetti",disconnectSuccess:"Dispositivo disconnesso",disconnectSuccessMessage:"Il dispositivo \xe8 stato disconnesso con successo.",disconnectSuccessWithSessions:"Dispositivo disconnesso con sessioni",hoursAgo:"{{count}} ore fa",loading:"Caricamento dispositivi...",minutesAgo:"{{count}} minuti fa",noDevices:"Nessun dispositivo connesso",noDevicesDescription:"I dispositivi appariranno qui quando accedi da piattaforme diverse",registeredDevices:"Dispositivi registrati",thisDevice:"Questo dispositivo"},liveAiDataFlow:{subtitle:"Visualizzazione pipeline end-to-end per funzionalita AI in diretta",tabs:{dubbing:"Doppiaggio",translation:"Traduzione",trivia:"Trivia"},title:"Flusso dati AI in diretta",services:{elevenlabs:"ElevenLabs",googleCloud:"Google Cloud",googleTranslate:"Google Translate",openai:"OpenAI",claude:"Claude",spacy:"spaCy",redis:"Redis",tavily:"Tavily"},translation:{nodes:{auth:{title:"WebSocket Auth + Rate Limit",input:"WebSocket connection request with JWT token",output:"Authenticated session with rate limit applied"},quota:{title:"Quota Check (30s cache)",input:"User ID and feature type",output:"Quota validation result (cached 30s)"},stt:{title:"STT (ElevenLabs Scribe v2)",input:"Raw audio stream from channel",output:"Transcribed text segments with timestamps"},dedup:{title:"Deduplication (70% overlap)",input:"New transcript segment",output:"Filtered unique segments (70% overlap threshold)"},predictive:{title:"Predictive Subtitle Emit (optional)",input:"Original language transcript",output:"Early subtitle display before translation"},translate:{title:"Translation (Google/OpenAI/Claude)",input:"Original language text segment",output:"Translated text in target language"},chunk:{title:"Text Chunking (max 80 chars)",input:"Translated text of any length",output:"Chunks of max 80 characters for display"},emit:{title:"Final Subtitle Emit",input:"Chunked translated subtitle",output:"WebSocket event to client with subtitle data"}}},dubbing:{nodes:{auth:{title:"WebSocket Auth + Rate Limit",input:"WebSocket connection request with JWT token",output:"Authenticated session with rate limit applied"},quota:{title:"Quota Check",input:"User ID and dubbing feature type",output:"Quota validation result"},session:{title:"Session Init + ChannelSTTManager Subscribe",input:"Channel ID and language preferences",output:"Subscribed to shared STT channel manager"},stt:{titl