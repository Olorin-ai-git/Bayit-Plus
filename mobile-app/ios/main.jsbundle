t+ Assistant",greeting:"Hello! I'm Bayit+ smart assistant. How can I help you today? Click the microphone and speak, or type a message."},chatbot:{title:"Bayit+ Assistant",greeting:"Hello! I'm Bayit+ smart assistant. How can I help you today? Click the microphone and speak, or type a message.",openChat:"Open chat",welcome:"Hello! I'm the Bayit+ smart assistant. How can I help you today? Click the microphone and speak, or type a message.",placeholder:"Type here...",recording:"Recording... click again to stop",transcribing:"Transcribing...",stopRecording:"Stop recording",startRecording:"Start voice recording",recommendations:"Here are some recommendations:",showMultipleSuccess:"Showing {{count}} content items in widgets",showMultipleNotFound:"Could not find the requested content. Please try different names.",resolvingContent:"Finding your content...",errors:{micPermission:"Could not access microphone. Please check microphone permissions in your browser.",transcribeFailed:"Could not transcribe the recording. Please try again.",general:"Sorry, something went wrong. Please try again."},suggestions:{whatToWatch:"What to watch today?",israeliMovies:"Recommended Israeli movies",whatsOnNow:"What's on now?",popularPodcasts:"Popular podcasts"},voiceCommands:{showChannels:"Show me channels...",playChess:"Start a chess game with...",multiContent:"Show side by side..."},listening:"Listening...",processing:"Processing..."},chess:{title:"Chess",welcome:"Welcome to Chess",subtitle:"Play chess with friends and family around the world",createGame:"Create New Game",joinGame:"Join Game",gameCode:"Game Code",enterGameCode:"Enter Game Code",invalidGameCode:"Invalid game code. Must be 6 characters.",joinFailed:"Failed to join game",join:"Join",create:"Create",chooseColor:"Choose Your Color",white:"White",black:"Black",chatPlaceholder:"Type a message... (@bot for advice)",botHint:"Tag @bot in your message to get chess advice from our AI assistant",bot:"Chess Assistant",mute:"Mute",unmute:"Unmute",speaking:"participants",resign:"Resign",offerDraw:"Offer Draw",newGame:"New Game",checkmate:"Checkmate!",stalemate:"Stalemate",draw:"Draw",resigned:"Game Resigned",reconnecting:"Reconnecting...",moveHistory:"Move History",noMoves:"No moves yet",showHints:"Show Guide Hints",yourTurn:"Your Turn",opponentTurn:"Opponent's Turn",waitingForOpponent:"Waiting for opponent...",gameOver:"Game Over",sendingInvite:"Sending game invite to {{name}}...",inviteSent:"Game invite sent to {{name}}! Game code: {{code}}",inviteFailed:"Could not find that user. Please check the name and try again.",inviteReceived:"{{name}} invited you to a chess game!",joinInvite:"Join Game",challenge:"Challenge",playedAsWhite:"Played as White",playedAsBlack:"Played as Black",gameMode:"Game Mode",playVsFriend:"Play vs Friend",playVsBot:"Play vs Bot",difficulty:"Difficulty",easy:"Easy",medium:"Medium",hard:"Hard",chessBot:"Chess Bot",disconnected:"Disconnected",theirTurn:"Their turn"},children:{title:"Kids",items:"items",empty:"No content available",emptyHint:"Try another category",exitKidsMode:"Exit Kids Mode",exitDescription:"Enter parent code to exit",parentCode:"Parent code",confirm:"Confirm",wrongCode:"Incorrect code",noContent:"No content available",tryAnotherCategory:"Try selecting another category",liveEducational:"Live Educational Channel",categories:{all:"All",cartoons:"Cartoons",educational:"Educational",music:"Music",hebrew:"Hebrew",stories:"Stories",jewish:"Jewish"},ageRatings:{3:"Ages 3+",5:"Ages 5+",7:"Ages 7+",10:"Ages 10+",12:"Ages 12+"},moderation:{pending:"Pending Review",approved:"Approved",rejected:"Rejected"},admin:{stats:"Kids Content Manager",seedContent:"Seed Content",importArchive:"Import Archive.org",syncPodcasts:"Sync Podcasts",syncYouTube:"Sync YouTube",tagVod:"Tag VOD",pendingModeration:"Pending Moderation"}},cities:{jerusalem:{title:"Jerusalem",subtitle:"Discover the eternal city",loadingContent:"Loading Jerusalem content...",noContent:"No content available at this time",errorLoading:"Failed to load Jerusalem content",sources:"Sources",categories:{history:"\ud83c\udfdb\ufe0f Historical Sites",religion:"\ud83d\udd4d Religious Heritage",culture:"\ud83c\udfad Cultural Events",events:"\ud83d\udcc5 Local Events",food:"\ud83c\udf74 Culinary Delights",markets:"\ud83d\udecd\ufe0f Traditional Markets",arts:"\ud83c\udfa8 Arts & Galleries"}},telAviv:{title:"Tel Aviv",subtitle:"Experience the vibrant city",loadingContent:"Loading Tel Aviv content...",noContent:"No content available at this time",errorLoading:"Failed to load Tel Aviv content",sources:"Sources",categories:{beaches:"\ud83c\udfd6\ufe0f Beaches & Waterfront",nightlife:"\ud83c\udf03 Nightlife & Entertainment",culture:"\ud83c\udfad Cultural Events",music:"\ud83c\udfb5 Music & Concerts",food:"\ud83c\udf74 Dining & Food Scene",tech:"\ud83d\udcbb Tech & Innovation",events:"\ud83d\udcc5 Local Events"}},privacy:{lastUpdated:"Last Updated: January 27, 2026",intro:{title:"1. Introduction",content:'Olorin.ai LLC ("we," "our," or "the Company") is committed to protecting your privacy. This Privacy Policy explains how our mobile application, Bayit+ (the "App"), collects, uses, and safeguards your information.',commitment:"We built Bayit+ with a \"Privacy-First\" architecture. We do not record your living room. Our technology uses your device's sensors solely to synchronize our audio service with your television."},collection:{title:"2. Information We Collect & How We Use It",camera:{title:"A. Camera & Visual Synchronization Data",intro:"To provide our core service\u2014synchronizing translated audio with your TV\u2014Bayit+ requires access to your device's Camera.",data:'Data Collected: When you activate "Sync Mode," the App captures a short sequence of video frames (approximately 3 seconds) from your TV screen.',purpose:"Purpose: These frames are transmitted to our secure cloud server solely to identify the public TV channel you are watching and calculate the broadcast latency (time delay).",retention:"Retention: This data is ephemeral. The frames are processed instantly in memory and are permanently deleted immediately after the synchronization is established. We do not view, store, or archive images of your home or family."},audio:{title:"B. Audio Data (If Applicable)",intro:"If you utilize features requiring audio synchronization, the App may request Microphone access.",data:"Data Collected: Brief audio samples of the TV broadcast.",purpose:"Purpose: To match the audio fingerprint of the public broadcast for synchronization purposes.",retention:"Retention: Like visual data, audio samples are processed in real-time and immediately deleted. We do not listen to or record user conversations."},usage:{title:"C. Usage & Technical Data",content:"We may collect non-identifiable technical data to improve App stability, including:",device:"Device type and operating system version.",crash:"Crash logs and performance metrics.",aggregate:'Aggregate data on which channels are being watched (e.g., "50% of users are watching Channel 12").'}},sharing:{title:"3. Data Sharing and Third Parties",noSale:"Olorin.ai LLC does not sell your personal data. We partner with trusted third-party service providers to deliver our infrastructure. These providers are authorized to use your data only as necessary to provide these services to us:",cloud:"Cloud Infrastructure: Hosting services (e.g., AWS) to process synchronization requests.",ai:"AI Processing: Services used to generate real-time text and audio translations from public broadcast feeds."},retention:{title:"4. Data Retention",sync:"Sync Data (Images/Audio): 0 days. Deleted immediately after processing.",account:"Account Data: Retained only as long as your account is active to manage your subscription and preferences."},children:{title:"5. Children's Privacy",content:"While our content is suitable for all ages, Olorin.ai LLC does not knowingly collect personal identifiable information from children under the age of 13. If you are a parent and believe your child has provided us with personal information, please contact us."},rights:{title:"6. Your Rights",content:"Depending on your location, you may have the right to request access to, correction of, or deletion of your personal data. You may delete your Bayit+ account at any time within the App settings."},contact:{title:"7. Contact Us",intro:"If you have any questions about this Privacy Policy, please contact us at:"}},beta:{credits:{loading:"Loading credit balance...",error:"Failed to load credit balance",label:"AI Credits",balance:"Beta Credits",subtitle:"Your AI feature credits",charged:"Charged",remaining:"Remaining",criticalLow:"Credit balance critically low! You have less than 10% remaining.",runningLow:"Your credit balance is running low. Consider budgeting your usage.",warningCritical:"\ud83d\udea8 Critical: Running out of credits",warningLow:"\u26a0\ufe0f Warning: Low credit balance",expiresOn:"Credits expire on {{date}}",usdValue:"USD Value",refresh:"Refresh Balance",upgrade:"Upgrade Plan",upgradeAction:"Upgrade to get more credits",remainingCredits:"Credits"},settings:{title:"Beta Programs",description:"Manage your Beta 500 enrollment and view program details. Get early access to AI-powered features.",enrolledTitle:"You're in Beta 500!",statusPendingVerification:"Pending Verification",statusActive:"Active",statusExpired:"Expired",pendingMessage:"We're verifying your enrollment. You'll receive an email once approved.",expiresOn:"Expires on {{date}}",loadingStatus:"Loading program status...",errorLoading:"Unable to load program information. Please try again.",programStatus:"Program Status",slots:"slots filled",slotsAvailable:"{{count}} slots available",programFull:"All 500 slots filled"},enrollment:{title:"Join Beta 500",subtitle:"Be one of 500 families to experience AI-powered features",programFull:"Program Full",joinButton:"Join Beta 500",exclusiveAccess:"Exclusive Access",limitedSlots:"Limited to 500 families",slotsAv